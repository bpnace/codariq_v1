---
import Base from "../layouts/Base.astro";
import FAQSchema from "../components/FAQSchema.astro";

const faqItems = [
  {
    category: "Start",
    question: "Für welche Unternehmen sind KI-Agenten sinnvoll?",
    answer:
      "Für Selbstständige, kleine Teams und KMU, die regelmäßig Zeit mit Postfach, Dokumenten, CRM-Pflege, Follow-ups oder Übergaben zwischen Tools verlieren. Entscheidend ist ein wiederkehrender Ablauf, der heute zu viel Aufmerksamkeit bindet.",
  },
  {
    category: "Ablauf",
    question: "Wie starten wir ohne großes Projekt?",
    answer:
      "Wir wählen zuerst einen klaren Startpunkt, prüfen Datenquellen und legen fest, wo der Agent vorbereiten darf und wo eine Freigabe nötig bleibt. Danach entsteht ein kleiner, kontrollierbarer Workflow statt ein großes System auf Verdacht.",
  },
  {
    category: "Zeitrahmen",
    question: "Wie schnell kann ein erster Agent nutzbar sein?",
    answer:
      "Ein klar begrenzter Agenten-Workflow ist oft in wenigen Wochen nutzbar. Der genaue Zeitraum hängt davon ab, welche Tools angebunden werden, wie sauber die Daten vorliegen und wie viele Sonderfälle berücksichtigt werden müssen.",
  },
  {
    category: "Datenschutz",
    question: "Wie bleibt das DSGVO-konform?",
    answer:
      "Wir klären vor der Umsetzung, welche Daten verarbeitet werden, welche Anbieter passen, welche Zugriffe nötig sind und wo Freigaben eingebaut werden. Kritische Aktionen werden nachvollziehbar vorbereitet statt blind ausgeführt.",
  },
  {
    category: "Integration",
    question: "Können bestehende Systeme angebunden werden?",
    answer:
      "Ja. Typisch sind E-Mail, Kalender, CRM, Buchhaltung, Formulare, Dokumentenablagen und Projekttools. Wir prüfen pragmatisch, welche Verbindung stabil ist und wo eine einfache Alternative sinnvoller wäre.",
  },
  {
    category: "Kosten",
    question: "Wie viel kostet eine KI-Automatisierung?",
    answer:
      "Die Pakete starten ab 399 €, 1.499 € und 3.499 €. Der Preis hängt vom Umfang, den angebundenen Systemen, der Datenlage und dem nötigen Sicherheitsrahmen ab. Vor der Umsetzung bekommst du einen klaren Plan mit Dauer und Ergebnis.",
  },
  {
    category: "Betrieb",
    question: "Was passiert nach dem Livegang?",
    answer:
      "Wir beobachten die ersten Ergebnisse, fangen Sonderfälle ab und justieren nach. Optional bleibt Betreuung möglich, wenn sich Tools, Daten oder Prozesse ändern oder der Agent später erweitert werden soll.",
  },
  {
    category: "Rettung",
    question: "Was, wenn ein KI-Projekt schon festhängt?",
    answer:
      "Dann prüfen wir Scope, Daten, Prompts, Tool-Anbindungen und Zuständigkeiten. Oft braucht es weniger neue Features, sondern einen klareren Ablauf, saubere Grenzen und eine stabile Übergabe in den Alltag.",
  },
];

// TODO: FAQ-Fragen später um weitere Einwände aus Erstgesprächen, Betriebsdetails und konkrete Integrationsfälle erweitern.
---

<Base
  title="FAQ - Häufige Fragen zu KI-Agenten und Automatisierung | Codariq"
  description="Kompakte Antworten zu KI-Agenten, DSGVO, Kosten, Zeitrahmen, Integration und Betrieb kontrollierbarer Automatisierung für Selbstständige, kleine Teams und KMU."
  forceNavSolid={true}
>
  <FAQSchema faqs={faqItems} />

  <section class="faq-page">
    <div class="saas-container faq-page__inner">
      <a href="/" class="faq-page__back" aria-label="Zurück zur Startseite">
        <span aria-hidden="true">←</span>
        Startseite
      </a>

      <header class="faq-page__intro" aria-labelledby="faq-title">
        <div>
          <h1 id="faq-title">Noch Fragen?</h1>
          <p>
            Kurz geklärt, damit du besser einschätzen kannst, wann ein
            kontrollierbarer KI-Agent sinnvoll ist und wie der Start abläuft.
          </p>
        </div>
      </header>

      <section class="faq-page__questions" aria-labelledby="faq-questions">
        <div class="faq-page__section-head">
          <span>Hier findest du deine Antwort</span>
          <h2 id="faq-questions">Kurz und konkret</h2>
        </div>

        <div class="faq-page__list">
          {
            faqItems.map((faq, index) => (
              <details class="faq-page__item" open={index === 0}>
                <summary>
                  <span class="faq-page__category">{faq.category}</span>
                  <h3>{faq.question}</h3>
                  <span class="faq-page__toggle" aria-hidden="true">
                    +
                  </span>
                </summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </section>

      <div class="faq-page__contact">
        <p>Eine konkrete Frage zu deinem Ablauf?</p>
        <a href="/#final-cta">Kurz schildern</a>
      </div>
    </div>
  </section>
</Base>

<style>
  :global(html),
  :global(body) {
    overflow-x: clip;
  }

  .faq-page {
    background: #f7fafc;
    padding: clamp(5.5rem, 7vw, 7.5rem) 0 clamp(4.5rem, 7vw, 6.5rem);
  }

  .faq-page__inner {
    width: min(100% - 2rem, 1180px);
  }

  .faq-page__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #64748b;
    font-size: 0.92rem;
    font-weight: 850;
    transition: color 170ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .faq-page__back:hover {
    color: #0f766e;
  }

  .faq-page__intro {
    width: 100%;
    margin-top: 2.2rem;
    padding-bottom: 2.2rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.1);
  }

  .faq-page__section-head > span {
    display: inline-flex;
    width: fit-content;
    color: #ecfeff;
    background: #0f766e;
    border-radius: 7px;
    padding: 0.42rem 0.56rem;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .faq-page__intro h1 {
    max-width: none;
    color: #0b1220;
    font-size: 3.15rem;
    font-weight: 940;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .faq-page__intro p {
    max-width: 58rem;
    margin-top: 1rem;
    color: #64748b;
    font-size: 1.08rem;
    font-weight: 580;
    line-height: 1.55;
  }

  .faq-page__questions {
    display: grid;
    grid-template-columns: minmax(11rem, 0.28fr) minmax(0, 0.72fr);
    gap: clamp(1.4rem, 4vw, 4rem);
    margin-top: clamp(2rem, 4vw, 3.2rem);
  }

  .faq-page__section-head {
    position: sticky;
    top: 4rem;
    z-index: 10;
    align-self: start;
    padding-top: 1rem;
  }

  .faq-page__section-head h2 {
    margin-top: 1rem;
    max-width: 10ch;
    color: #0b1220;
    font-size: 2rem;
    font-weight: 920;
    letter-spacing: 0;
    line-height: 1;
  }

  .faq-page__list {
    display: grid;
    gap: 0.85rem;
  }

  .faq-page__item {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 12px;
    box-shadow: 0 18px 48px rgba(15, 23, 42, 0.045);
    overflow: hidden;
  }

  .faq-page__item summary {
    display: grid;
    grid-template-columns: minmax(5.8rem, 0.22fr) minmax(0, 1fr) 2rem;
    gap: 1rem;
    align-items: center;
    padding: 1.15rem 1.2rem;
    cursor: pointer;
    list-style: none;
  }

  .faq-page__item summary::-webkit-details-marker {
    display: none;
  }

  .faq-page__category {
    color: #0f766e;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .faq-page__item h3 {
    color: #0b1220;
    font-size: 1.18rem;
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.14;
  }

  .faq-page__toggle {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 8px;
    background: rgba(20, 184, 166, 0.12);
    color: #0f766e;
    font-size: 1.2rem;
    font-weight: 900;
    transition:
      transform 170ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 170ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .faq-page__item[open] .faq-page__toggle {
    transform: rotate(45deg);
    background: #14b8a6;
    color: #052e2b;
  }

  .faq-page__item p {
    max-width: 58rem;
    padding: 0 1.2rem 1.2rem calc(22% + 2.2rem);
    color: #64748b;
    font-size: 0.98rem;
    font-weight: 570;
    line-height: 1.58;
  }

  .faq-page__contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
    padding: 1rem 1.15rem;
    background: #0b1220;
    border-radius: 12px;
    color: #cbd5e1;
    font-size: 0.96rem;
    font-weight: 650;
  }

  .faq-page__contact a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.78rem 1rem;
    background: #14b8a6;
    color: #052e2b;
    border-radius: 8px;
    font-weight: 900;
    white-space: nowrap;
    transition:
      transform 170ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 170ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .faq-page__contact a:hover {
    background: #2dd4bf;
  }

  .faq-page__contact a:active {
    transform: translateY(1px) scale(0.985);
  }

  @media (max-width: 840px) {
    .faq-page__intro,
    .faq-page__questions {
      grid-template-columns: 1fr;
    }

    .faq-page__section-head {
      position: static;
    }

    .faq-page__section-head h2 {
      max-width: none;
      font-size: 1.6rem;
    }

    .faq-page__intro h1 {
      font-size: 2.25rem;
    }

    .faq-page__intro p {
      font-size: 1rem;
    }

    .faq-page__item h3 {
      font-size: 1.06rem;
    }

    .faq-page__item summary {
      grid-template-columns: 1fr 2rem;
      gap: 0.75rem 1rem;
    }

    .faq-page__category {
      grid-column: 1 / -1;
    }

    .faq-page__item p {
      padding: 0 1.2rem 1.2rem;
    }

    .faq-page__contact {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
