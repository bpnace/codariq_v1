---
import Base from "../layouts/Base.astro";
import LandingHeroSection from "../components/LandingHeroSection.astro";
import TrustSignalsSection from "../components/TrustSignalsSection.astro";
import AgentReadinessSection from "../components/AgentReadinessSection.astro";
import PricingTiersSection from "../components/PricingTiersSection.astro";
import UseCaseProofSection from "../components/UseCaseProofSection.astro";
import DeliveryProcessSection from "../components/DeliveryProcessSection.astro";
import BlogInsightsSection from "../components/BlogInsightsSection.astro";
import HomeFAQSection from "../components/HomeFAQSection.astro";
import LeadCaptureSection from "../components/LeadCaptureSection.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
---

<Base
  title="codariq - kontrollierbare KI-Agenten für konkrete Arbeit"
  description="Codariq baut kontrollierbare KI-Agenten für Selbstständige, CEOs, kleine Teams und KMU: mit Aufgabenräumen, Datenwegen, Freigaben, Logs und menschlicher Kontrolle."
  ogImage="https://codariq.de/images/hero/hero2.webp"
  preloadHeroImage
>
  <!-- Structured Data -->
  <BreadcrumbSchema />

  <!-- LandingHeroSection Section -->
  <LandingHeroSection
    primaryCTA="Agent erstellen"
    secondaryCTA="Was darf ein Agent?"
    secondaryCTALink="/agent-readiness"
  />

  <!-- Trust Bar -->
  <TrustSignalsSection />

  <!-- Pain Points -->
  <AgentReadinessSection />

  <!-- DeliveryProcessSection -->
  <DeliveryProcessSection />

  <!-- PricingTiersSection -->
  <PricingTiersSection />

  <!-- Use case proof -->
  <UseCaseProofSection />

  <!-- Final CTA -->
  <LeadCaptureSection />

  <!-- Blog Preview -->
  <BlogInsightsSection />

  <!-- Short FAQ -->
  <HomeFAQSection />

  <div class="home-scroll-blur" data-home-scroll-blur aria-hidden="true">
    <span class="home-scroll-blur__layer home-scroll-blur__layer--soft"></span>
    <span class="home-scroll-blur__layer home-scroll-blur__layer--mid"></span>
    <span class="home-scroll-blur__layer home-scroll-blur__layer--deep"></span>
  </div>
</Base>

<style>
  .home-scroll-blur {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 40;
    height: clamp(7rem, 13svh, 9rem);
    overflow: hidden;
    pointer-events: none;
    isolation: isolate;
  }

  .home-scroll-blur::before,
  .home-scroll-blur::after {
    content: none;
  }

  .home-scroll-blur__layer {
    position: absolute;
    inset: 0;
  }

  .home-scroll-blur__layer--soft {
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 24%,
      rgba(0, 0, 0, 0.18) 56%,
      rgba(0, 0, 0, 0.72) 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 24%,
      rgba(0, 0, 0, 0.18) 56%,
      rgba(0, 0, 0, 0.72) 100%
    );
  }

  .home-scroll-blur__layer--mid {
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 48%,
      rgba(0, 0, 0, 0.16) 72%,
      rgba(0, 0, 0, 0.64) 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 48%,
      rgba(0, 0, 0, 0.16) 72%,
      rgba(0, 0, 0, 0.64) 100%
    );
  }

  .home-scroll-blur__layer--deep {
    backdrop-filter: blur(44px);
    -webkit-backdrop-filter: blur(44px);
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 68%,
      rgba(0, 0, 0, 0.2) 86%,
      rgba(0, 0, 0, 0.78) 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 68%,
      rgba(0, 0, 0, 0.2) 86%,
      rgba(0, 0, 0, 0.78) 100%
    );
  }

  @media (max-width: 720px) {
    .home-scroll-blur__layer--mid,
    .home-scroll-blur__layer--deep {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
