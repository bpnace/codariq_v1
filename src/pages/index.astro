---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import PainList from "../components/PainList.astro";
import Benefits from "../components/Benefits.astro";
import Testimonials from "../components/Testimonials.astro";
import Process from "../components/Process.astro";
import BlogPreview from "../components/BlogPreview.astro";
import SeoEntryPoints from "../components/SeoEntryPoints.astro";
import HomeFAQ from "../components/HomeFAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
---

<Base
  title="Codariq - Sichere KI-Agenten für echte Arbeit"
  description="Codariq baut kontrollierbare KI-Agenten für Selbstständige, kleine Teams und KMU: mit klaren Datenwegen, Freigaben, Logs und menschlicher Kontrolle."
  ogImage="https://codariq.de/images/hero/hero2.webp"
>
  <!-- Structured Data -->
  <BreadcrumbSchema />

  <!-- Hero Section -->
  <Hero
    primaryCTA="Grenzen klären"
    secondaryCTA="Was darf ein Agent?"
    secondaryCTALink="/automatisierungs-check"
  />

  <!-- Trust Bar -->
  <TrustBar />

  <!-- Pain Points -->
  <PainList />

  <!-- Process -->
  <Process />

  <!-- Benefits -->
  <Benefits />

  <!-- Search Intent Entry Points -->
  <SeoEntryPoints />

  <!-- Testimonials -->
  <Testimonials />

  <!-- Final CTA -->
  <FinalCTA />

  <!-- Blog Preview -->
  <BlogPreview />

  <!-- Short FAQ -->
  <HomeFAQ />

  <div class="home-scroll-blur" data-home-scroll-blur aria-hidden="true">
    <span class="home-scroll-blur__layer home-scroll-blur__layer--soft"></span>
    <span class="home-scroll-blur__layer home-scroll-blur__layer--mid"></span>
    <span class="home-scroll-blur__layer home-scroll-blur__layer--deep"></span>
  </div>
</Base>

<style>
  .home-scroll-blur {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 40;
    height: clamp(5rem, 12.5svh, 9rem);
    overflow: hidden;
    pointer-events: none;
    isolation: isolate;
  }

  .home-scroll-blur::after {
    position: absolute;
    inset: 0;
    z-index: 2;
    content: "";
    background: linear-gradient(
      to top,
      rgba(3, 7, 18, 0.22) 0%,
      rgba(3, 7, 18, 0.15) 22%,
      rgba(3, 7, 18, 0.08) 48%,
      rgba(3, 7, 18, 0.025) 76%,
      rgba(3, 7, 18, 0) 100%
    );
  }

  .home-scroll-blur__layer {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .home-scroll-blur__layer--soft {
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    mask-image: linear-gradient(to top, #000 0%, transparent 100%);
    -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 100%);
  }

  .home-scroll-blur__layer--mid {
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    mask-image: linear-gradient(to top, #000 0%, transparent 68%);
    -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 68%);
  }

  .home-scroll-blur__layer--deep {
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    mask-image: linear-gradient(to top, #000 0%, transparent 22%);
    -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 22%);
  }
</style>
