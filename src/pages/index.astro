---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import PainList from "../components/PainList.astro";
import Benefits from "../components/Benefits.astro";
import Testimonials from "../components/Testimonials.astro";
import Process from "../components/Process.astro";
import BlogPreview from "../components/BlogPreview.astro";
import HomeFAQ from "../components/HomeFAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
---

<Base
  title="Codariq - KI-Agenten und KI-Integration für Selbstständige, kleine Teams und KMU"
  description="Kontrollierbare KI-Agenten und KI-Integration für Selbstständige, kleine Teams und KMU: E-Mails sortieren, Dokumente verarbeiten, bestehende Systeme verbinden und Routineaufgaben mit klaren Freigaben vorbereiten."
  ogImage="https://codariq.de/images/hero/hero2.webp"
>
  <!-- Structured Data -->
  <BreadcrumbSchema />

  <!-- Hero Section -->
  <Hero
    secondaryCTA="Agenten-Potenzial prüfen"
    secondaryCTALink="/automatisierungs-check"
  />

  <!-- Trust Bar -->
  <TrustBar />

  <!-- Pain Points -->
  <PainList />

  <!-- Process -->
  <Process />

  <!-- Benefits -->
  <Benefits />

  <!-- Testimonials -->
  <Testimonials />

  <!-- Final CTA -->
  <FinalCTA />

  <!-- Blog Preview -->
  <BlogPreview />

  <!-- Short FAQ -->
  <HomeFAQ />
</Base>
