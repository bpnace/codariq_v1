---
import Base from "../layouts/Base.astro";
import LandingHeroSection from "../components/LandingHeroSection.astro";
import TrustSignalsSection from "../components/TrustSignalsSection.astro";
import AgentReadinessSection from "../components/AgentReadinessSection.astro";
import PricingTiersSection from "../components/PricingTiersSection.astro";
import UseCaseProofSection from "../components/UseCaseProofSection.astro";
import DeliveryProcessSection from "../components/DeliveryProcessSection.astro";
import BlogInsightsSection from "../components/BlogInsightsSection.astro";
import SeoIntentEntryPointsSection from "../components/SeoIntentEntryPointsSection.astro";
import HomeFAQSection from "../components/HomeFAQSection.astro";
import LeadCaptureSection from "../components/LeadCaptureSection.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
---

<Base
  title="codariq - kontrollierbare KI-Agenten für echte Arbeit"
  description="Codariq baut kontrollierbare KI-Agenten für Selbstständige, CEOs, kleine Teams und KMU: mit Aufgabenräumen, Datenwegen, Freigaben, Logs und menschlicher Kontrolle."
  ogImage="https://codariq.de/images/hero/hero2.webp"
  preloadHeroImage
>
  <!-- Structured Data -->
  <BreadcrumbSchema />

  <!-- LandingHeroSection Section -->
  <LandingHeroSection
    primaryCTA="Grenzen prüfen"
    secondaryCTA="Was darf ein Agent?"
    secondaryCTALink="/agent-readiness"
  />

  <!-- Trust Bar -->
  <TrustSignalsSection />

  <!-- Pain Points -->
  <AgentReadinessSection />

  <!-- DeliveryProcessSection -->
  <DeliveryProcessSection />

  <!-- PricingTiersSection -->
  <PricingTiersSection />

  <!-- Search Intent Entry Points -->
  <SeoIntentEntryPointsSection />

  <!-- Use case proof -->
  <UseCaseProofSection />

  <!-- Final CTA -->
  <LeadCaptureSection />

  <!-- Blog Preview -->
  <BlogInsightsSection />

  <!-- Short FAQ -->
  <HomeFAQSection />

  <div class="home-scroll-blur" data-home-scroll-blur aria-hidden="true">
    <span class="home-scroll-blur__layer home-scroll-blur__layer--soft"></span>
    <span class="home-scroll-blur__layer home-scroll-blur__layer--mid"></span>
    <span class="home-scroll-blur__layer home-scroll-blur__layer--deep"></span>
  </div>
</Base>

<style>
  .home-scroll-blur {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 40;
    height: clamp(5rem, 12.5svh, 9rem);
    overflow: hidden;
    pointer-events: none;
    isolation: isolate;
  }

  .home-scroll-blur::after {
    position: absolute;
    inset: 0;
    z-index: 2;
    content: "";
    background: linear-gradient(
      to top,
      rgba(3, 7, 18, 0.22) 0%,
      rgba(3, 7, 18, 0.15) 22%,
      rgba(3, 7, 18, 0.08) 48%,
      rgba(3, 7, 18, 0.025) 76%,
      rgba(3, 7, 18, 0) 100%
    );
  }

  .home-scroll-blur__layer {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .home-scroll-blur__layer--soft {
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    mask-image: linear-gradient(to top, #000 0%, transparent 100%);
    -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 100%);
  }

  .home-scroll-blur__layer--mid {
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    mask-image: linear-gradient(to top, #000 0%, transparent 68%);
    -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 68%);
  }

  .home-scroll-blur__layer--deep {
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    mask-image: linear-gradient(to top, #000 0%, transparent 22%);
    -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 22%);
  }

  @media (max-width: 720px) {
    .home-scroll-blur__layer--mid,
    .home-scroll-blur__layer--deep {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
