---
import Base from "../layouts/Base.astro";
import SeoContentHeroSection from "../components/SeoContentHeroSection.astro";
import UseCaseCardsSection from "../components/UseCaseCardsSection.astro";
import FAQ from "../components/FAQ.astro";
import LeadCaptureSection from "../components/LeadCaptureSection.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import FAQSchema from "../components/FAQSchema.astro";

const useCases = [
  {
    title: "Status Updates automatisch bündeln",
    description:
      "Updates werden aus euren Tools gesammelt und als kurzer Überblick erstellt, damit ihr weniger Abstimmung braucht.",
    outcome: "Weniger Meetings, bessere Übersicht.",
    icon: "book",
  },
  {
    title: "Übergaben zwischen Tools automatisieren",
    description:
      "Aufgaben wandern automatisch zwischen CRM, Projekttool und Postfach, ohne manuelle Copy Paste Schritte.",
    outcome: "Saubere Abläufe ohne Brüche.",
    icon: "link",
  },
  {
    title: "Interner KI Assistent aus eurem Wissen",
    description:
      "Wissen aus E Mails, Dokumenten und Tickets wird auffindbar. Auf Wunsch beantwortet ein Assistent Fragen aus euren eigenen Inhalten.",
    outcome: "Schnelleres Onboarding und weniger Rückfragen.",
    icon: "document",
  },
];

const processSteps = [
  {
    number: 1,
    title: "Reibung finden",
    description:
      "Wir schauen, wo dein Team täglich Zeit verliert, zum Beispiel bei Abstimmung, Aufgabenübergaben oder doppelter Pflege.",
    details: [
      "Übersicht der wichtigsten Abläufe",
      "Identifikation von Bruchstellen",
      "Benennung der Zuständigkeiten",
    ],
    duration: "3 bis 5 Tage",
    result: "Ein kompakter Überblick über die wichtigsten Engpässe.",
  },
  {
    number: 2,
    title: "Systeme verbinden",
    description:
      "Wir verbinden eure Tools und automatisieren Übergaben und Status Updates. Dann testen wir mit realen Fällen.",
    details: [
      "Tools verbinden ohne Brüche",
      "Automatische Status Berichte",
      "Tests mit realen Abläufen",
    ],
    duration: "2 bis 4 Wochen",
    result: "Ein stabiler Ablauf mit geregelten Zuständigkeiten.",
  },
  {
    number: 3,
    title: "Stabilisieren und skalieren",
    description:
      "Wir optimieren Sonderfälle und erweitern den Ablauf auf weitere Bereiche.",
    details: [
      "Feintuning für Sonderfälle",
      "Kurze Einweisung fürs Team",
      "Optional: Ausbau weiterer Workflows",
    ],
    duration: "2 bis 6 Wochen Begleitung",
    result: "Weniger Chaos, mehr Fokus im Alltag.",
  },
];

const faqs = [
  {
    question: "Wie hilft Automatisierung kleinen Teams?",
    answer:
      "Durch weniger Abstimmung, saubere Übergaben und automatische Status Updates. So muss seltener nachgefragt werden und Arbeit bleibt nicht liegen.",
  },
  {
    question: "Was passiert, wenn Prozesse sich ändern?",
    answer:
      "Wir bauen so, dass Anpassungen möglich sind. Änderungen lassen sich in der Regel schnell einpflegen.",
  },
  {
    question: "Müssen alle Tools ersetzt werden?",
    answer:
      "Nein, wir verbinden vorhandene Tools. Ziel ist weniger Tool-Wechsel, nicht ein kompletter Neustart.",
  },
  {
    question: "Wie entstehen automatische Status Updates?",
    answer:
      "Wir bündeln Daten aus deinen Systemen und erstellen automatisch brauchbare Zusammenfassungen.",
  },
  {
    question: "Wie bleibt das Team eingebunden?",
    answer:
      "Wir führen die Automatisierung schrittweise ein und geben kurze Einweisungen, damit jeder weiß, was passiert.",
  },
  {
    question: "Wie bleibt das DSGVO konform?",
    answer:
      "Zugriffsrechte, Datenflüsse und Speicherorte werden verbindlich geregelt. Auf Wunsch EU Hosting und AVV.",
  },
  {
    question: "Welche Team-Abläufe eignen sich für KI-Agenten?",
    answer:
      "Gute Startpunkte sind Übergaben, Status-Updates, Support-Anfragen, interne Rückfragen, CRM-Aufgaben, Dokumentenablage und Meeting-Nachbereitung. Entscheidend ist, dass der Ablauf oft genug wiederkommt.",
  },
  {
    question: "Kann ein Agent Teamwissen auffindbar machen?",
    answer:
      "Ja. Der Agent kann Dokumente, Notizen, Tickets oder Projektstände durchsuchen und Antworten vorbereiten. Quellen und Grenzen bleiben sichtbar, damit niemand blind auf eine Antwort vertrauen muss.",
  },
  {
    question: "Wie verhindert ihr zusätzliche Tool-Komplexität?",
    answer:
      "Wir verbinden bestehende Systeme, bevor ein neues Tool entsteht. Der Agent soll weniger Wechsel, weniger Suche und weniger Nachfragen erzeugen, statt ein weiteres Dashboard zu pflegen.",
  },
  {
    question: "Wie werden Freigaben im Team geregelt?",
    answer:
      "Wir legen fest, wer welche Entscheidungen prüft: externe Nachrichten, Kundendaten, sensible Dokumente, Eskalationen oder Budgetthemen. Der Agent stoppt dort und übergibt mit Kontext.",
  },
  {
    question: "Funktioniert das mit Remote-Teams?",
    answer:
      "Ja. Gerade Remote-Teams profitieren von vorbereiteten Statusständen, geordneten Übergaben und weniger Zurufen. Wichtig sind feste Quellen, Rollen und ein einfacher Review-Rhythmus.",
  },
  {
    question: "Wie schnell merkt ein kleines Team Entlastung?",
    answer:
      "Wenn der Startfall gut gewählt ist, oft nach wenigen Wochen. Spürbar wird es dort, wo weniger gesucht, kopiert, nachgefragt oder in Meetings erklärt werden muss.",
  },
];
---

<Base
  title="KI-Agenten für kleine Teams: Übergaben, Status und Freigaben | codariq"
  description="Kontrollierbare KI-Agenten für kleine Teams: Status bündeln, Übergaben vorbereiten, Tools verbinden und Freigaben sichtbar halten."
  keywords="KI Agenten kleine Teams, kontrollierbare KI Agenten, Team Übergaben, Status Updates bündeln, Tools verbinden, Freigaben KI Agent, Backoffice Agent, operative Abläufe"
  ogImage="/images/hero/hero2.webp"
>
  <BreadcrumbSchema
    items={[
      {
        name: "KI-Agenten für kleine Teams",
        url: "https://codariq.de/ki-agenten-kleine-teams",
      },
    ]}
  />
  <FAQSchema faqs={faqs} />

  <SeoContentHeroSection
    title="KI-Agenten für kleine Teams, die Übergaben sauber vorbereiten"
    subtitle="Wenn dein Team ständig nachfragt, Dinge doppelt einträgt oder Status in Meetings erklärt, kostet das jeden Tag Zeit. Wir verbinden eure Tools so, dass Agenten bündeln, vorbereiten und bei Freigaben stoppen."
    heroImage="/images/hero/hero2.webp"
    primaryCTA="Jetzt anfragen"
    primaryCTALink="/#final-cta"
    secondaryCTA="Use Cases ansehen"
    secondaryCTALink="#use-cases"
  />

  <section id="fuer-wen" class="py-12 sm:py-16 md:py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-3 sm:px-4 md:px-6 lg:px-12 xl:px-16">
      <div class="text-center mb-10 sm:mb-12">
        <h2 class="section-title mb-3 sm:mb-4">Für wen das passt</h2>
        <p class="section-subtitle max-w-3xl mx-auto">
          Wenn Wissen, Status und Übergaben über mehrere Tools verteilt sind,
          verliert ein kleines Team jeden Tag Zeit. Der erste Agent sollte dort
          starten, wo Rückfragen und Nacharbeit am häufigsten auftreten.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        <div class="bg-white rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-base sm:text-lg font-black text-gray-900 mb-3">
            Für wen
          </h3>
          <ul class="space-y-2 text-sm sm:text-base font-medium text-gray-600">
            <li>Teams, die Status in Meetings wieder zusammensuchen</li>
            <li>Teams mit Übergaben zwischen Postfach, CRM und Projekttool</li>
            <li>
              Remote-Teams mit vielen Rückfragen zu Dokumenten und Tickets
            </li>
            <li>
              Teams, die Freigaben und Zuständigkeiten verbindlicher brauchen
            </li>
          </ul>
        </div>
        <div class="bg-white rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-base sm:text-lg font-black text-gray-900 mb-3">
            Worauf wir achten
          </h3>
          <ul class="space-y-2 text-sm sm:text-base font-medium text-gray-600">
            <li>Der Agent bekommt feste Quellen und benannte Owner</li>
            <li>Externe Nachrichten und sensible Daten bleiben mit Freigabe</li>
            <li>
              Der Ablauf senkt Abstimmung, statt ein weiteres Board zu pflegen
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="value-focus" class="py-12 sm:py-16 md:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-3 sm:px-4 md:px-6 lg:px-12 xl:px-16">
      <div class="text-center mb-10 sm:mb-12">
        <h2 class="section-title mb-3 sm:mb-4">
          Weniger Abstimmung, mehr Umsetzung
        </h2>
        <p class="section-subtitle max-w-3xl mx-auto">
          Wenn du Prozesse automatisieren willst, ist das oft der schnellste
          Hebel: saubere Übergaben und automatische Status Updates. So entsteht
          zentrale Organisation, ohne mehr Meetings.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        <div class="bg-gray-50 rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-base sm:text-lg font-black text-gray-900 mb-2">
            Weniger Meetings
          </h3>
          <p
            class="text-sm sm:text-base font-medium text-gray-600 leading-relaxed"
          >
            Status Updates laufen automatisch, statt in täglichen Abstimmungen.
          </p>
        </div>
        <div class="bg-gray-50 rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-base sm:text-lg font-black text-gray-900 mb-2">
            Saubere Übergaben
          </h3>
          <p
            class="text-sm sm:text-base font-medium text-gray-600 leading-relaxed"
          >
            Aufgaben wandern automatisch an die richtigen Personen oder Systeme.
          </p>
        </div>
        <div class="bg-gray-50 rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-base sm:text-lg font-black text-gray-900 mb-2">
            Bessere Übersicht
          </h3>
          <p
            class="text-sm sm:text-base font-medium text-gray-600 leading-relaxed"
          >
            Weniger Suche, mehr Sicht auf den aktuellen Stand.
          </p>
        </div>
      </div>
    </div>
  </section>

  <UseCaseCardsSection
    title="3 Use Cases für kleine Teams"
    subtitle="Beispiele für Team Koordination, Status Updates und Übergaben zwischen Tools."
    useCases={useCases}
  />

  <section id="sicherheit-daten" class="py-12 sm:py-16 md:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-3 sm:px-4 md:px-6 lg:px-12 xl:px-16">
      <div class="text-center mb-10 sm:mb-12">
        <h2 class="section-title mb-3 sm:mb-4">
          Sicherheit und Zuständigkeiten
        </h2>
        <p class="section-subtitle max-w-3xl mx-auto">
          Kleine Teams brauchen keine große Governance-Sprache. Sie brauchen
          Regeln, die im Alltag halten: Wer darf sehen, wer gibt frei und wann
          stoppt der Agent.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        <div class="bg-gray-50 rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-base sm:text-lg font-black text-gray-900 mb-2">
            Rollen und Quellen
          </h3>
          <p
            class="text-sm sm:text-base font-medium text-gray-600 leading-relaxed"
          >
            Der Agent liest nur freigegebene Quellen und trennt Teamwissen,
            Kundendaten und interne Notizen.
          </p>
        </div>
        <div class="bg-gray-50 rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-base sm:text-lg font-black text-gray-900 mb-2">
            Freigaben im Ablauf
          </h3>
          <p
            class="text-sm sm:text-base font-medium text-gray-600 leading-relaxed"
          >
            Nachrichten, Kundendaten und Budgetthemen werden vorbereitet und an
            die zuständige Person übergeben.
          </p>
        </div>
        <div class="bg-gray-50 rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-base sm:text-lg font-black text-gray-900 mb-2">
            Nachvollziehbare Übergaben
          </h3>
          <p
            class="text-sm sm:text-base font-medium text-gray-600 leading-relaxed"
          >
            Status, Quellen und offene Punkte bleiben sichtbar, damit das Team
            dem Ergebnis nicht blind folgen muss.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="process" class="py-10 sm:py-12 bg-white">
    <div class="max-w-5xl mx-auto px-3 sm:px-4 md:px-6 lg:px-10">
      <div class="text-center mb-8 sm:mb-10">
        <h2 class="section-title mb-3 sm:mb-4">
          Unser Ablauf für stabile Workflows
        </h2>
        <p class="section-subtitle max-w-3xl mx-auto">
          So bringen wir Ordnung in Abläufe, ohne dein Team zu überfordern.
        </p>
      </div>

      <div class="space-y-3 sm:space-y-4">
        {
          processSteps.map((step, index) => (
            <details
              class="group/compact rounded-xl border border-gray-200 bg-gray-50 p-4 sm:p-5"
              open={index === 0}
            >
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
                <div>
                  <p class="text-xs sm:text-sm font-semibold text-orange-600 mb-1">
                    Schritt {step.number} · {step.duration}
                  </p>
                  <h3 class="text-base sm:text-lg font-black text-gray-900">
                    {step.title}
                  </h3>
                </div>
                <svg
                  class="w-5 h-5 text-gray-400 mt-1 transition-transform duration-200 group-open/compact:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </summary>

              <div class="pt-3 sm:pt-4">
                <p class="text-sm sm:text-base font-medium text-gray-600 leading-relaxed mb-3">
                  {step.description}
                </p>
                <ul class="space-y-2 text-sm sm:text-base font-medium text-gray-600 leading-relaxed">
                  {step.details.map((detail) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-2 h-1.5 w-1.5 rounded-full bg-orange-500 flex-shrink-0" />
                      <span>{detail}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-4 border-t border-gray-200 pt-3">
                  <p class="text-sm sm:text-base font-semibold text-gray-900">
                    Ergebnis:
                  </p>
                  <p class="text-sm sm:text-base font-medium text-gray-600 leading-relaxed">
                    {step.result}
                  </p>
                </div>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <LeadCaptureSection
    title="Lass uns eure Übergaben sauber eingrenzen"
    description="Wir finden die größten Reibungsverluste und bauen Agenten-Workflows, die Daten, Freigaben und Zuständigkeiten sichtbar halten."
  />

  <FAQ
    title="FAQ: KI-Agenten für kleine Teams"
    subtitle="Kurz erklärt, damit du die nächsten Schritte kennst."
    faqs={faqs}
  />
</Base>
