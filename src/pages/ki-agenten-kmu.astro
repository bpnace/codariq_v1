---
import Base from "../layouts/Base.astro";
import SeoContentHeroSection from "../components/SeoContentHeroSection.astro";
import UseCaseCardsSection from "../components/UseCaseCardsSection.astro";
import FAQ from "../components/FAQ.astro";
import LeadCaptureSection from "../components/LeadCaptureSection.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import FAQSchema from "../components/FAQSchema.astro";

const useCases = [
  {
    title: "Postfach-Agent",
    description:
      "Sortiert Anfragen, erkennt Dringlichkeit, erstellt Antwortentwürfe und übergibt Aufgaben mit Kontext an CRM, Kalender oder Projekttool.",
    outcome: "Schneller reagieren, ohne ständig im Postfach zu hängen.",
    icon: "mail",
  },
  {
    title: "Backoffice-Agent",
    description:
      "Verarbeitet Dokumente, benennt Dateien, bereitet Rechnungsdaten vor und markiert Sonderfälle für menschliche Prüfung.",
    outcome: "Weniger manuelle Ablage und weniger Copy Paste.",
    icon: "document",
  },
  {
    title: "Wissens-Agent",
    description:
      "Macht interne Informationen aus Dokumenten, Notizen und Tickets auffindbar, ohne dass dein Team alles neu strukturieren muss.",
    outcome: "Schnellere Antworten und weniger Rückfragen im Team.",
    icon: "book",
  },
];

const buildSteps = [
  {
    title: "Ablauf verstehen",
    text: "Wir prüfen, welche Aufgabe der Agent übernehmen soll, welche Daten nötig sind und wo ein Mensch entscheiden muss.",
  },
  {
    title: "Agenten-Grenzen definieren",
    text: "Der Agent bekommt feste Rollen, erlaubte Aktionen, Freigaben und Abbruchpunkte. So entsteht kein unkontrollierter Ablauf.",
  },
  {
    title: "n8n oder Agenten-Stack bauen",
    text: "Kleine Agenten starten pragmatisch mit n8n. Komplexere Setups bekommen eine kontrollierte Agenten-Architektur mit Tools, Logs und Betriebskonzept.",
  },
  {
    title: "Mit realen Fällen stabilisieren",
    text: "Wir testen mit Anfragen, Dokumenten und Sonderfällen aus deinem Alltag. Demo-Floskeln helfen im Betrieb nicht weiter.",
  },
];

const faqs = [
  {
    question: "Was ist der Unterschied zwischen Automatisierung und KI-Agent?",
    answer:
      "Eine klassische Automatisierung folgt festen Regeln. Ein KI-Agent kann Informationen lesen, priorisieren, zusammenfassen, Vorschläge erstellen und Aktionen vorbereiten. Wichtig bleibt: Er darf nur innerhalb definierter Grenzen handeln.",
    category: "Grundlagen",
  },
  {
    question: "Für welche KMU lohnt sich ein KI-Agent?",
    answer:
      "Besonders sinnvoll ist ein KI-Agent, wenn regelmäßig ähnliche Anfragen, Dokumente, Follow ups, Reports oder Übergaben anfallen und heute viel manuell geprüft, kopiert oder nachgefasst wird.",
    category: "Eignung",
  },
  {
    question: "Startet ihr direkt mit einem großen Agenten-System?",
    answer:
      "Nein. Wir starten mit dem kleinsten sinnvollen Agenten, oft als n8n-basierter Workflow mit KI-Schritten. Erst wenn Rollen, Datenfluss und Nutzen belastbar sind, lohnt sich ein größerer Agenten-Stack.",
    category: "Umsetzung",
  },
  {
    question: "Wie bleibt die Kontrolle beim Unternehmen?",
    answer:
      "Über Rollen, Freigaben, Logs, definierte Tool-Zugriffe und feste Stopps. Kritische Entscheidungen gehen an Menschen, bevor sie Wirkung nach außen haben.",
    category: "Kontrolle",
  },
  {
    question: "Wie geht ihr mit DSGVO um?",
    answer:
      "Wir planen Datenminimierung, Zugriffskonzepte, Speicherorte, Auftragsverarbeitung und Freigaben von Anfang an mit. Je nach Fall empfehlen wir EU-Hosting, getrennte Datenflüsse und Human-in-the-loop für sensible Entscheidungen.",
    category: "Datenschutz",
  },
  {
    question: "Welche KI-Agenten lohnen sich für KMU zuerst?",
    answer:
      "Gute Startpunkte sind Postfach-Agenten, CRM-Agenten, Support-Anfragen, Dokumentenprüfung, Reporting und interne Wissenssuche. Wichtig ist ein Ablauf mit Wiederholung, Datenquellen und messbarer Nacharbeit.",
    category: "Use Cases",
  },
  {
    question: "Kann ein KI-Agent mit n8n gebaut werden?",
    answer:
      "Ja. Viele KMU starten mit einem n8n-Agenten, wenn der Ablauf begrenzt ist und wenige Tools beteiligt sind. Größere Setups brauchen erst dann mehr Architektur, wenn Betrieb, Rollen und Kanäle wachsen.",
    category: "n8n",
  },
  {
    question: "Was kostet ein KI-Agent für ein KMU?",
    answer:
      "Der Preis hängt von Ablauf, Systemen, Datenqualität, Freigaben und Betrieb ab. Wir schätzen zuerst den kleinsten sinnvollen Start, damit kein großes Agenten-System gebaut wird, bevor der Nutzen belastbar ist.",
    category: "Kosten",
  },
  {
    question: "Wie wird ein KI-Agent im Betrieb betreut?",
    answer:
      "Ein produktiver Agent braucht Logs, Review-Rhythmus, Owner, Fehlerbehandlung und Regeln für Änderungen. Wir planen diese Punkte mit, damit der Agent nach dem Livegang nicht unkontrolliert weiterläuft.",
    category: "Betrieb",
  },
  {
    question: "Welche Rolle spielt der AI Act für KMU?",
    answer:
      "Je nach Use Case müssen Zweck, Risiken, Transparenz, menschliche Prüfung und Dokumentation betrachtet werden. Wir bauen technische Setups so, dass Prüfpflichten und Freigaben früh im Ablauf sichtbar sind.",
    category: "Compliance",
  },
];
---

<Base
  title="KI-Agenten für KMU: kontrolliert, DSGVO-orientiert und praxisnah | codariq"
  description="Codariq baut KI-Agenten für KMU: vom n8n-basierten Startablauf bis zu kontrollierten Agenten-Setups mit Freigaben, Rollen, Logs und DSGVO-orientierter Integration."
  keywords="KI Agenten KMU, KI-Agenten für Unternehmen, KI Agent bauen lassen, KI Agent DSGVO, n8n KI Agent, KI Agenten Setup, KI Integration bestehende Systeme, kontrollierbare KI Agenten"
  ogImage="/images/hero/hero2.webp"
>
  <BreadcrumbSchema
    items={[
      { name: "KI-Agenten für KMU", url: "https://codariq.de/ki-agenten-kmu" },
    ]}
  />
  <FAQSchema faqs={faqs} />

  <SeoContentHeroSection
    title="KI-Agenten für KMU, die Arbeit im Betrieb übernehmen."
    subtitle="Wir bauen kontrollierbare Agenten für Postfach, Backoffice, Support, Wissen und Reporting. Vom schlanken n8n-Workflow bis zum stabilen Agenten-Setup mit Freigaben, Rollen und DSGVO-konformer Datenführung."
    heroImage="/images/hero/hero2.webp"
    primaryCTA="Agenten-Grenzen prüfen"
    primaryCTALink="/#final-cta"
    secondaryCTA="Use Cases ansehen"
    secondaryCTALink="#use-cases"
  />

  <section id="fuer-wen" class="py-12 sm:py-16 md:py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-3 sm:px-4 md:px-6 lg:px-12 xl:px-16">
      <div class="text-center mb-10 sm:mb-12">
        <h2 class="section-title mb-3 sm:mb-4">Für wen das passt</h2>
        <p class="section-subtitle max-w-3xl mx-auto">
          Diese Seite ist für KMU mit wiederkehrender Arbeit in Postfach,
          Support, CRM oder Backoffice. KI soll dort keinen Demo-Effekt liefern,
          sondern einen begrenzten Arbeitsablauf tragen.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        <div class="bg-white rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-base sm:text-lg font-black text-gray-900 mb-3">
            Für wen
          </h3>
          <ul class="space-y-2 text-sm sm:text-base font-medium text-gray-600">
            <li>KMU mit wiederkehrenden Anfragen, Dokumenten oder Reports</li>
            <li>
              Teams, die n8n, CRM, Postfach oder Projekttools verbinden wollen
            </li>
            <li>
              Geschäftsführung, die Freigaben und Betrieb geregelt braucht
            </li>
            <li>
              Organisationen, die vor einem größeren Agenten-Stack prüfen wollen
            </li>
          </ul>
        </div>
        <div class="bg-white rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-base sm:text-lg font-black text-gray-900 mb-3">
            Worauf wir achten
          </h3>
          <ul class="space-y-2 text-sm sm:text-base font-medium text-gray-600">
            <li>Ein erster Agent bekommt einen engen Aufgabenraum</li>
            <li>
              Datenfluss, Tool-Zugriff und Freigaben werden vor dem Bau
              festgelegt
            </li>
            <li>Der Ausbau passiert erst, wenn Nutzung und Nutzen tragen</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="value-focus" class="py-12 sm:py-16 md:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-3 sm:px-4 md:px-6 lg:px-12 xl:px-16">
      <div class="text-center mb-10 sm:mb-12">
        <p
          class="text-sm font-bold uppercase tracking-[0.24em] text-orange-600 mb-3"
        >
          Von Automatisierung zu Agenten
        </p>
        <h2 class="section-title mb-4">
          Der nächste Schritt nach einfachen Workflows
        </h2>
        <p class="section-subtitle max-w-3xl mx-auto">
          Viele KMU starten mit Automatisierung, merken aber schnell: Feste
          Regeln reichen nicht, wenn E-Mails, Dokumente oder Kundenanfragen
            jedes Mal leicht anders aussehen. Dort lohnt sich ein KI-Agent.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        <div class="bg-gray-50 rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-lg font-black text-gray-900 mb-2">
            Er versteht Kontext
          </h3>
          <p class="text-gray-600 font-medium leading-relaxed">
            Der Agent erkennt Anliegen, Priorität und nächste Schritte, statt
            nur Wenn-dann-Regeln abzuarbeiten.
          </p>
        </div>
        <div class="bg-gray-50 rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-lg font-black text-gray-900 mb-2">
            Er bereitet Aktionen vor
          </h3>
          <p class="text-gray-600 font-medium leading-relaxed">
            Antworten, Aufgaben, Buchungen oder Datensätze entstehen
            vorbereitet, aber mit Freigabe dort, wo sie nötig ist.
          </p>
        </div>
        <div class="bg-gray-50 rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-lg font-black text-gray-900 mb-2">
            Er bleibt begrenzt
          </h3>
          <p class="text-gray-600 font-medium leading-relaxed">
            Rollen, Tool-Zugriffe, Logs und Stopps verhindern, dass ein Agent
            mehr tut als vereinbart.
          </p>
        </div>
      </div>
    </div>
  </section>

  <UseCaseCardsSection
    title="KI-Agenten, die im KMU-Alltag genutzt werden"
    subtitle="Drei Einstiege, die häufig schnell Orientierung geben: Postfach, Backoffice und internes Wissen."
    useCases={useCases}
  />

  <section id="sicherheit-daten" class="py-12 sm:py-16 md:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-3 sm:px-4 md:px-6 lg:px-12 xl:px-16">
      <div class="text-center mb-10 sm:mb-12">
        <h2 class="section-title mb-3 sm:mb-4">Sicherheit und Betrieb</h2>
        <p class="section-subtitle max-w-3xl mx-auto">
          Ein Agent im KMU braucht mehr als einen guten Prompt. Entscheidend
          sind Rollen, Logs, Fehlerwege und ein Owner, der den Ablauf im Betrieb
          verantwortet.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        <div class="bg-gray-50 rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-lg font-black text-gray-900 mb-2">
            Rollen und Freigaben
          </h3>
          <p class="text-gray-600 font-medium leading-relaxed">
            Kritische Schritte bekommen menschliche Prüfung, externe Wirkung
            bleibt im Entwurf oder Freigabemodus.
          </p>
        </div>
        <div class="bg-gray-50 rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-lg font-black text-gray-900 mb-2">
            Logs und Fehlerwege
          </h3>
          <p class="text-gray-600 font-medium leading-relaxed">
            Ergebnisse, Quellen und Abbrüche werden so dokumentiert, dass
            Ursachen später auffindbar bleiben.
          </p>
        </div>
        <div class="bg-gray-50 rounded-xl p-5 sm:p-6 border border-gray-200">
          <h3 class="text-lg font-black text-gray-900 mb-2">
            Stack mit Augenmaß
          </h3>
          <p class="text-gray-600 font-medium leading-relaxed">
            n8n reicht für viele Startfälle. OpenClaw oder ein größerer Stack
            kommt erst ins Spiel, wenn Betrieb und Kanäle es brauchen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="process" class="py-12 sm:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-3 sm:px-4 md:px-6 lg:px-10">
      <div class="text-center mb-8 sm:mb-10">
        <h2 class="section-title mb-4">
          So bauen wir deinen ersten KI-Agenten
        </h2>
        <p class="section-subtitle max-w-3xl mx-auto">
          Kein Agenten-Hype, sondern ein umsetzbarer Bauplan: Aufgabe,
          Datenfluss, Grenzen, Tests und Betrieb.
        </p>
      </div>

      <div class="space-y-4">
        {
          buildSteps.map((step, index) => (
            <div class="rounded-xl border border-gray-200 bg-gray-50 p-5 sm:p-6">
              <p class="text-sm font-bold text-orange-600 mb-1">
                Schritt {index + 1}
              </p>
              <h3 class="text-lg sm:text-xl font-black text-gray-900 mb-2">
                {step.title}
              </h3>
              <p class="text-gray-700 font-medium leading-relaxed">
                {step.text}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16 bg-gray-950 text-white">
    <div class="max-w-6xl mx-auto px-3 sm:px-4 md:px-6 lg:px-12 xl:px-16">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        <div>
          <p
            class="text-sm font-bold uppercase tracking-[0.24em] text-orange-300 mb-3"
          >
            Architektur statt Tool-Wildwuchs
          </p>
          <h2 class="text-3xl sm:text-4xl font-black leading-tight mb-4">
            Erst n8n, dann Agenten-Infrastruktur, wenn der Betrieb sie braucht.
          </h2>
          <p class="text-white/80 text-lg leading-relaxed">
            Nicht jedes KMU braucht sofort ein großes OpenClaw-Setup. Oft reicht
            ein begrenzter n8n-Agent als erster produktiver Schritt. Wenn mehrere
            Kanäle, Tools, Erinnerungen, Rollen und dauerhafter Betrieb
            dazukommen, planen wir den Ausbau bewusst.
          </p>
        </div>
        <div class="grid gap-4">
          <a
            href="/openclaw-agenten"
            class="block rounded-xl border border-white/15 bg-white/10 p-5 hover:bg-white/15 transition-colors"
          >
            <h3 class="font-black text-xl mb-2">OpenClaw-Setup prüfen</h3>
            <p class="text-white/75">
              Für Agenten, die über Kanäle, Tools, Modelle und Gateway
              kontrolliert laufen sollen.
            </p>
          </a>
          <a
            href="/dsgvo-ki-agenten"
            class="block rounded-xl border border-white/15 bg-white/10 p-5 hover:bg-white/15 transition-colors"
          >
            <h3 class="font-black text-xl mb-2">DSGVO-Architektur prüfen</h3>
            <p class="text-white/75">
              Für Datenflüsse, Freigaben, Rollen und menschliche Prüfung bei
              sensiblen Entscheidungen.
            </p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <LeadCaptureSection
    title="Lass uns deinen ersten KI-Agenten eingrenzen."
    description="In 30 Minuten finden wir heraus, welcher Agent Arbeit spart, welche Daten er braucht und ob ein n8n-Workflow reicht oder ein größerer Agenten-Stack sinnvoll ist."
  />

  <FAQ
    title="FAQ: KI-Agenten für KMU"
    subtitle="Kurz beantwortet, damit du Agenten realistisch einschätzen kannst."
    faqs={faqs}
  />
</Base>
