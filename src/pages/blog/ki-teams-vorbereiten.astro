  <section id="messung" class="mb-16">
    <div class="flex items-center gap-4 mb-6">
      <div class="w-12 h-12 bg-pink-100 rounded-full flex items-center justify-center">
        <span class="text-pink-600 font-bold text-lg">6</span>
