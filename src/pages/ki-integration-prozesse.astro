---
import SeoLandingPageTemplate from "../components/SeoLandingPageTemplate.astro";

const faqs = [
  {
    question: "Was bedeutet KI-Integration in Prozesse konkret?",
    answer:
      "KI-Integration in Prozesse heißt: Die KI arbeitet nicht isoliert in einem Chatfenster, sondern liest relevante Daten, bereitet nächste Schritte vor und übergibt Ergebnisse an die Systeme, in denen dein Team ohnehin arbeitet.",
    category: "Grundlagen",
  },
  {
    question: "Welche Prozesse eignen sich zuerst?",
    answer:
      "Gute Startpunkte sind wiederkehrende Abläufe mit klaren Quellen und sichtbarer Nacharbeit: Postfach-Triage, CRM-Übergaben, Dokumentenprüfung, Reporting, Support oder interne Rückfragen.",
    category: "Eignung",
  },
  {
    question: "Braucht KI-Integration sofort eine neue Plattform?",
    answer:
      "Nicht unbedingt. Oft reicht ein sauber begrenzter Workflow mit KI-Schritt. Eine größere KI-Cloud-Integrationsplattform lohnt sich erst, wenn mehrere Systeme, Rollen, Kanäle und Betriebsanforderungen zusammenkommen.",
    category: "Architektur",
  },
  {
    question: "Wie bleibt die Integration kontrollierbar?",
    answer:
      "Über klare Datenquellen, erlaubte Aktionen, Freigaben, Logs und Stopps. Kritische Ergebnisse werden vorbereitet, aber nicht blind ausgelöst.",
    category: "Kontrolle",
  },
];
