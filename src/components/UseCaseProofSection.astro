---
import { engpassRoutes } from "../data/engpassLandingPages";

export interface Props {
  title?: string;
  subtitle?: string;
  items?: Array<{
    kind: "feedback" | "useCase";
    body: string;
    heading: string;
    context: string;
    label: string;
    image?: string;
    results?: {
      metric: string;
      improvement: string;
    };
    link?: {
      href: string;
      label: string;
    };
    featured?: boolean;
  }>;
}

const {
  title = "Wo Agenten Teams Arbeit abnehmen",
  subtitle = "Zwei anonymisierte Rückmeldungen und Einsatzpunkte für Teams, Geschäftsführung und Selbstständige. Relevant wird ein Agent dort, wo Büroarbeit jeden Tag liegen bleibt.",
  items = [
    {
      kind: "feedback",
      body: '"Vor Terminen war bei uns immer die gleiche Sucherei... Letzte Mail, offene Punkte, fehlende Unterlagen. Wenn das vorher als kurze Zusammenfassung bereit liegt, gehen wir deutlich ruhiger ins Gespräch."',
      heading: "KI-Terminvorbereitung",
      context: "Mails, Notizen, offene Punkte",
      label: "Rückmeldung von Kunden",
      results: { metric: "Termin", improvement: "strukturiert geplant" },
      link: { href: engpassRoutes.terminmappe, label: "Termine vorbereiten" },
      featured: true,
    },
    {
      kind: "useCase",
      body: "Wenn Informationen in Mails, PDFs, Tickets und Köpfen verteilt sind, unterbricht jede Rückfrage den Arbeitstag. Der Agent sucht in freigegebenen Quellen, nennt den Fundort und bereitet eine ausführliche Antwort vor.",
      heading: "KI-Wissensmanagement",
      context: "Mails, PDFs, Tickets, Übergaben",
      label: "Nutzen für Teams",
      results: { metric: "Antwort", improvement: "mit Quelle erfasst" },
      link: { href: engpassRoutes.teamwissen, label: "Wissen bündeln" },
    },
    {
      kind: "useCase",
      body: "Neue Anfragen sind selten sofort entscheidungsreif. Der Agent ergänzt Firmendaten, bisherigen Kontakt, offene Fragen und eine nächste Handlung, bevor jemand zurückruft oder ein Angebot schreibt.",
      heading: "KI-Anfragebearbeitung",
      context: "Firma, Kontakt, nächste Handlung",
      label: "Nutzen für Selbstständige",
      results: { metric: "Anfrage", improvement: "ergänzt" },
      link: { href: engpassRoutes.anfragen, label: "Anfragen prüfen" },
    },
    {
      kind: "useCase",
      body: "Für die Geschäftsführung zählt der Stand von offenen Freigaben, blockierten Aufgaben, wichtigen Rückmeldungen und Risiken, die nicht bis Freitag liegen bleiben dürfen.",
      heading: "KI-Entscheidungsgrundlage",
      context: "Freigaben, Blocker, Risiken",
      label: "Nutzen für Geschäftsführung",
      results: { metric: "Stand", improvement: "immer sichtbar" },
      link: {
        href: engpassRoutes.entscheidungen,
        label: "Stand vorbereiten",
      },
    },
    {
      kind: "feedback",
      body: '"Ich brauche morgens eine kurze Liste: was neu ist, was hängt, was ich freigeben muss und wo eine Entscheidung ansteht. Dann kann ich direkt loslegen."',
      heading: "KI-Management-Reporting",
      context: "Freigaben, Rückfragen, offene Aufgaben",
      label: "Rückmeldung von Kunden",
      results: { metric: "Überblick", improvement: "vorbereitet" },
      link: { href: engpassRoutes.chefUeberblick, label: "Überblick prüfen" },
    },
    {
      kind: "useCase",
      body: "Listen, Rechnungen und Formulare kommen aus Postfach, Exporten und Ordnern. Der Agent findet Dubletten, fehlende Angaben und falsche Ablageorte, bevor daraus Nacharbeit wird.",
      heading: "KI-Dokumentenablage",
      context: "Listen, Rechnungen, Ablage",
      label: "Nutzen für Backoffice",
      results: { metric: "Ablage", improvement: "logisch sortiert" },
      link: { href: engpassRoutes.unterlagen, label: "Ablage prüfen" },
    },
  ],
} = Astro.props;
---

<section id="testimonials" data-enterprise-section class="proof-suite">
  <div class="saas-container">
    <div class="saas-heading saas-heading--center enterprise-reveal">
      <span>Typische Engpässe</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="proof-suite__grid" data-testimonial-reveal>
      {
        items.map((item, index) => {
          const cardClass = `proof-card enterprise-card ${item.kind === "feedback" || item.featured ? "proof-card--featured" : ""}`;
          const scribbleMaskId = `proof-card-scribble-mask-${index}`;
          const content = (
            <>
              <div class="proof-card__meta">
                <span>{item.label}</span>
                <strong>{item.heading}</strong>
                <p>{item.context}</p>
              </div>
              {item.kind === "feedback" ? (
                <blockquote class="proof-card__body">{item.body}</blockquote>
              ) : (
                <p class="proof-card__body">{item.body}</p>
              )}
              {item.results && (
                <div class="proof-card__result">
                  <strong>
                    <span class="proof-card__metric-label">
                      {item.results.metric}
                    </span>
                    {item.link && (
                      <svg
                        class="proof-card__scribble"
                        viewBox="0 0 172 56"
                        aria-hidden="true"
                        focusable="false"
                        pointer-events="none"
                      >
                        <defs>
                          <mask id={scribbleMaskId} maskUnits="userSpaceOnUse">
                            <path
                              class="proof-card__scribble-reveal"
                              pathLength="1"
                              d="M 28 36 C 12 31, 18 17, 42 10 C 78 0, 140 3, 161 20 C 180 35, 153 51, 108 54 C 63 57, 19 50, 10 39 C 1 28, 19 17, 45 12"
                            />
                          </mask>
                        </defs>
                        <path
                          class="proof-card__scribble-stroke"
                          fill="#14b8a6"
                          mask={`url(#${scribbleMaskId})`}
                          d="M 28 36 C 10 31, 17 16, 42 8 C 79 -3, 140 3, 162 20 C 182 36, 152 52, 105 55 C 60 58, 18 50, 9 39 C 0 28, 18 16, 45 10 C 52 9, 54 15, 47 17 C 25 22, 12 30, 17 37 C 26 48, 64 53, 105 50 C 149 47, 172 35, 156 24 C 134 10, 78 4, 44 14 C 23 20, 19 30, 29 33 C 34 35, 33 38, 28 36 Z"
                        />
                      </svg>
                    )}
                  </strong>
                  <span>{item.results.improvement}</span>
                </div>
              )}
            </>
          );

          return item.link ? (
            <a
              href={item.link.href}
              class={cardClass}
              data-testimonial-card
              data-proof-kind={item.kind}
              aria-label={`${item.heading}: ${item.link.label}`}
            >
              {content}
            </a>
          ) : (
            <article
              class={cardClass}
              data-testimonial-card
              data-proof-kind={item.kind}
            >
              {content}
            </article>
          );
        })
      }
    </div>

    <div class="proof-suite__cta enterprise-reveal">
      <div>
        <strong>Kommt dir einer davon bekannt vor?</strong>
        <p>
          Wir schauen auf einen Arbeitsablauf und prüfen, ob ein Agent dort
          vorbereiten, sortieren oder mit Freigabe handeln sollte.
        </p>
      </div>
      <a class="proof-suite__primary" href="#final-cta">
        Jetzt Projekt anfragen
      </a>
    </div>
  </div>
</section>

<style>
  .proof-suite {
    background: #ffffff;
    padding: clamp(4.5rem, 2vw, 7rem) 0;
  }

  .proof-suite .saas-heading--center h2 {
    max-width: 18ch;
  }

  .proof-suite__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2.8rem;
  }

  .proof-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 22rem;
    color: inherit;
    text-decoration: none;
    background: #f8fafc;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    padding: 1.2rem;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.06);
    transform-origin: 50% 82%;
    will-change: transform, opacity, filter;
    transition:
      transform 170ms cubic-bezier(0.23, 1, 0.32, 1),
      border-color 170ms cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 170ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  a.proof-card {
    cursor: pointer;
  }

  a.proof-card:hover {
    transform: translateY(-3px);
    border-color: rgba(15, 118, 110, 0.22);
    box-shadow: 0 28px 68px rgba(15, 23, 42, 0.1);
  }

  a.proof-card:active {
    transform: translateY(-1px) scale(0.996);
  }

  a.proof-card:focus-visible {
    outline: 3px solid rgba(20, 184, 166, 0.34);
    outline-offset: 4px;
  }

  .proof-card--featured {
    background: linear-gradient(135deg, #ecfdf5, #eff6ff);
  }

  .proof-card__meta span {
    color: #0f766e;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .proof-card__meta strong {
    display: block;
    margin-top: 0.55rem;
    color: #0b1220;
    font-size: 1.16rem;
    font-weight: 900;
  }

  .proof-card__meta p {
    margin-top: 0.18rem;
    color: #64748b;
    font-size: 0.9rem;
    font-weight: 620;
  }

  .proof-card__body {
    margin-top: 1.3rem;
    color: #334155;
    font-size: 1rem;
    font-weight: 590;
    line-height: 1.55;
  }

  .proof-card__result {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.2rem;
  }

  .proof-card__result strong {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
    color: #0b1220;
    font-size: 1.55rem;
    font-weight: 950;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .proof-card__metric-label {
    position: relative;
    z-index: 1;
    -webkit-text-stroke: 0.012em currentColor;
    text-shadow: 0.006em 0 0 currentColor;
  }

  .proof-card__result > span {
    color: #0f766e;
    text-align: right;
    font-size: 0.86rem;
    font-weight: 850;
  }

  .proof-card__scribble {
    position: absolute;
    inset: -0.62rem -0.95rem -0.54rem -0.62rem;
    z-index: 0;
    width: calc(100% + 1.57rem);
    height: calc(100% + 1.16rem);
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    transform: rotate(-1.6deg) scale(0.985);
    transform-origin: 52% 58%;
    transition:
      opacity 120ms cubic-bezier(0.65, 0, 0.35, 1) 35ms,
      transform 520ms cubic-bezier(0.65, 0, 0.35, 1) 35ms;
  }

  .proof-card__scribble-stroke {
    fill: #14b8a6;
    fill-rule: nonzero;
  }

  .proof-card__scribble-reveal {
    fill: none;
    stroke: #ffffff;
    stroke-width: 12;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  a.proof-card:is(:hover, :focus-visible) .proof-card__scribble {
    opacity: 1;
    transform: rotate(-1.6deg) scale(1);
  }

  a.proof-card:is(:hover, :focus-visible) .proof-card__scribble-reveal {
    animation: proof-card-pen-mark 480ms cubic-bezier(0.65, 0, 0.35, 1) 30ms
      forwards;
  }

  @keyframes proof-card-pen-mark {
    0% {
      stroke-dashoffset: 1;
    }

    18% {
      stroke-dashoffset: 0.8;
    }

    66% {
      stroke-dashoffset: 0.12;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  .proof-suite__cta {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.2rem;
    align-items: center;
    margin-top: 1rem;
    background: #0b1220;
    color: #f8fafc;
    border-radius: 16px;
    padding: 1.25rem;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.13);
  }

  .proof-suite__cta strong {
    display: block;
    font-size: 1.2rem;
    font-weight: 900;
  }

  .proof-suite__cta p {
    margin-top: 0.35rem;
    color: #cbd5e1;
    font-weight: 570;
    line-height: 1.45;
  }

  .proof-suite__primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.8rem 1rem;
    background: #14b8a6;
    color: #052e2b;
    border-radius: 8px;
    font-weight: 900;
  }

  @media (max-width: 1040px) {
    .proof-suite__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 700px) {
    .proof-suite__grid,
    .proof-suite__cta {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a.proof-card:hover,
    a.proof-card:active {
      transform: none;
    }

    a.proof-card:is(:hover, :focus-visible) .proof-card__scribble {
      opacity: 1;
      transform: rotate(-1.6deg) scale(1);
    }

    a.proof-card:is(:hover, :focus-visible) .proof-card__scribble-reveal {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
