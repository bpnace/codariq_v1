---
export interface Props {
  title?: string;
  subtitle?: string;
  testimonials?: Array<{
    quote: string;
    name: string;
    position: string;
    company: string;
    image?: string;
    results?: {
      metric: string;
      improvement: string;
    };
    featured?: boolean;
  }>;
}

const {
  title = "So fühlt sich Entlastung im Alltag an",
  subtitle = "Typische Beispielszenarien aus Gesprächen mit Selbstständigen, kleinen Teams und KMU. Keine erfundenen Kundenstimmen, sondern realistische Muster, damit du einschätzen kannst, was bei dir möglich ist.",
  testimonials = [
    {
      quote:
        "Als Solo-Selbstständiger fühlt es sich schnell so an, als würde jeden Tag dieselbe Büroarbeit warten: Anfragen, Angebote, Ablage, Nachfassen. Ein sinnvoller Agenten-Workflow bereitet diese Schritte vor, während du die wichtigen Entscheidungen behältst.",
      name: "Beispiel: Solo-Dienstleister",
      position: "Anfragen, Angebote, Ablage",
      company: "Typisches Szenario",
      results: { metric: "1", improvement: "klarer Workflow" },
      featured: true,
    },
    {
      quote:
        "Im Support lohnt sich kein blinder Autopilot. Sinnvoller ist ein KI-Agent, der Anfragen sortiert, Antwortentwürfe vorbereitet und unsichere Fälle zur Freigabe an Menschen gibt.",
      name: "Beispiel: Support-Team",
      position: "Triage und Antwortentwürfe",
      company: "Typisches Szenario",
      results: { metric: "klar", improvement: "Freigaben" },
    },
    {
      quote:
        "Bei Rechnungen und Dokumenten geht es nicht nur um Auslesen. Entscheidend ist, dass Dateien korrekt benannt, abgelegt und mit dem passenden nächsten Schritt verbunden werden.",
      name: "Beispiel: Backoffice",
      position: "Dokumente und Rechnungen",
      company: "Typisches Szenario",
      results: { metric: "weniger", improvement: "Nacharbeit" },
    },
    {
      quote:
        "Wenn ein KI-Projekt festhängt, hilft oft kein weiteres Feature. Erst Scope, Daten, Prompts und Zuständigkeiten klären, dann kann aus Projektrettung wieder ein stabiler Ablauf werden.",
      name: "Beispiel: KI-Remediation",
      position: "Festgefahrenes Projekt",
      company: "Typisches Szenario",
      results: { metric: "Scope", improvement: "geklärt" },
    },
    {
      quote:
        "Ein Wissens-Agent ist nützlich, wenn er Quellen zeigt, Zugriffe respektiert und nicht so tut, als wüsste er alles. Dann finden Teams Antworten schneller und lernen trotzdem sauber weiter.",
      name: "Beispiel: Wissens-Agent",
      position: "Interne Fragen und Quellen",
      company: "Typisches Szenario",
      results: { metric: "mit", improvement: "Quellen" },
    },
    {
      quote:
        "Bei kleinen Unternehmen und KMU zählt nicht der größte KI-Stack. Entscheidend ist ein Agent, der bestehende Systeme verbindet und einen wiederkehrenden Prozess zuverlässig vorbereitet.",
      name: "Beispiel: KMU-Prozess",
      position: "Tool-Stack und Übergaben",
      company: "Typisches Szenario",
      results: { metric: "1", improvement: "Startprozess" },
    },
  ],
} = Astro.props;
---

<section id="testimonials" data-enterprise-section class="proof-suite">
  <div class="saas-container">
    <div class="saas-heading saas-heading--center enterprise-reveal">
      <span>Use Case Evidence</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="proof-suite__grid">
      {
        testimonials.map((testimonial) => (
          <article
            class={`proof-card enterprise-card ${testimonial.featured ? "proof-card--featured" : ""}`}
          >
            <div class="proof-card__meta">
              <span>{testimonial.company}</span>
              <strong>{testimonial.name}</strong>
              <p>{testimonial.position}</p>
            </div>
            <blockquote>{testimonial.quote}</blockquote>
            {testimonial.results && (
              <div class="proof-card__result">
                <strong>{testimonial.results.metric}</strong>
                <span>{testimonial.results.improvement}</span>
              </div>
            )}
          </article>
        ))
      }
    </div>

    <div class="proof-suite__cta enterprise-reveal">
      <div>
        <strong>Klingt nach Entlastung?</strong>
        <p>
          In 30 Minuten schauen wir auf deinen Arbeitsalltag und finden ein bis
          zwei Stellen, an denen ein KI-Agent oder eine sichere KI-Integration
          konkret hilft.
        </p>
      </div>
      <a href="#final-cta">Termin buchen</a>
    </div>
  </div>
</section>

<style>
  .proof-suite {
    background: #ffffff;
    padding: clamp(4.5rem, 2vw, 7rem) 0;
  }

  .proof-suite .saas-heading--center h2 {
    max-width: 18ch;
  }

  .proof-suite__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2.8rem;
  }

  .proof-card {
    display: flex;
    flex-direction: column;
    min-height: 22rem;
    background: #f8fafc;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    padding: 1.2rem;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.06);
  }

  .proof-card--featured {
    background: linear-gradient(135deg, #ecfdf5, #eff6ff);
  }

  .proof-card__meta span {
    color: #0f766e;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .proof-card__meta strong {
    display: block;
    margin-top: 0.55rem;
    color: #0b1220;
    font-size: 1.16rem;
    font-weight: 900;
  }

  .proof-card__meta p {
    margin-top: 0.18rem;
    color: #64748b;
    font-size: 0.9rem;
    font-weight: 620;
  }

  .proof-card blockquote {
    margin-top: 1.3rem;
    color: #334155;
    font-size: 1rem;
    font-weight: 590;
    line-height: 1.55;
  }

  .proof-card__result {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.2rem;
  }

  .proof-card__result strong {
    color: #0b1220;
    font-size: 1.55rem;
    font-weight: 950;
    letter-spacing: -0.05em;
  }

  .proof-card__result span {
    color: #0f766e;
    text-align: right;
    font-size: 0.86rem;
    font-weight: 850;
  }

  .proof-suite__cta {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.2rem;
    align-items: center;
    margin-top: 1rem;
    background: #0b1220;
    color: #f8fafc;
    border-radius: 16px;
    padding: 1.25rem;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.13);
  }

  .proof-suite__cta strong {
    display: block;
    font-size: 1.2rem;
    font-weight: 900;
  }

  .proof-suite__cta p {
    margin-top: 0.35rem;
    color: #cbd5e1;
    font-weight: 570;
    line-height: 1.45;
  }

  .proof-suite__cta a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.8rem 1rem;
    background: #14b8a6;
    color: #052e2b;
    border-radius: 8px;
    font-weight: 900;
  }

  @media (max-width: 1040px) {
    .proof-suite__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 700px) {
    .proof-suite__grid,
    .proof-suite__cta {
      grid-template-columns: 1fr;
    }
  }
</style>
