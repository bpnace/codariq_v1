---
export interface Props {
  badges?: Array<{
    name: string;
    icon: string;
    description: string;
  }>;
  showLogos?: boolean;
  className?: string;
}

const {
  badges = [
    {
      name: "DSGVO konform",
      icon: "gdpr-ready",
      description:
        "Datenverarbeitung, Rollen und Freigaben werden vor dem Agenten-Livegang dokumentiert.",
    },
    {
      name: "EU-gehostet",
      icon: "EU-hosted",
      description:
        "Setups werden so geplant, dass sensible Daten in passenden EU-Umgebungen bleiben.",
    },
    {
      name: "Auditierbar",
      icon: "remote-only",
      description:
        "Agenten-Aktionen, Übergaben und Freigaben bleiben nachvollziehbar statt Blackbox.",
    },
  ],
  className = "",
} = Astro.props;
---

<section
  id="trust-bar"
  data-enterprise-section
  class={`trust-cloud ${className}`}
>
  <div class="trust-cloud__inner enterprise-reveal">
    <div class="trust-cloud__label">
      <span>Security baseline</span>
      <strong>Für kleine Teams gebaut, aber mit Konzern-Disziplin.</strong>
    </div>
    <div class="trust-cloud__items">
      {
        badges.map((badge) => (
          <article class="trust-pill enterprise-card">
            <img
              src={`/images/badges/${badge.icon}.webp`}
              alt=""
              aria-hidden="true"
              loading="lazy"
            />
            <div>
              <h3>{badge.name}</h3>
              <p>{badge.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .trust-cloud {
    background: #f7fafc;
    padding: 2rem 1rem 4.5rem;
  }

  .trust-cloud__inner {
    width: min(100%, 1440px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.48fr 1fr;
    gap: 1.2rem;
    align-items: stretch;
  }

  .trust-cloud__label,
  .trust-pill {
    background: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 14px;
    box-shadow: 0 18px 50px rgba(15, 23, 42, 0.06);
  }

  .trust-cloud__label {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.4rem;
  }

  .trust-cloud__label span {
    color: #0f766e;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .trust-cloud__label strong {
    display: block;
    margin-top: 0.55rem;
    color: #0b1220;
    font-size: clamp(1.28rem, 2vw, 2.1rem);
    font-weight: 920;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .trust-cloud__items {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .trust-pill {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1.15rem;
  }

  .trust-pill img {
    width: 2.2rem;
    height: 2.8rem;
    object-fit: contain;
  }

  .trust-pill h3 {
    color: #0b1220;
    font-size: 1.02rem;
    font-weight: 900;
  }

  .trust-pill p {
    margin-top: 0.42rem;
    color: #64748b;
    font-size: 0.9rem;
    font-weight: 590;
    line-height: 1.44;
  }

  @media (max-width: 960px) {
    .trust-cloud__inner,
    .trust-cloud__items {
      grid-template-columns: 1fr;
    }
  }
</style>
