---
export interface Props {
  title?: string;
  subtitle?: string;
  steps?: Array<{
    number: number;
    title: string;
    description: string;
    details: string[];
    duration: string;
    result: string;
  }>;
}

const {
  title = "So läuft die Zusammenarbeit",
  subtitle = "Ein klarer Ablauf, damit dein erster KI-Agent schnell entlastet und kontrollierbar bleibt. DSGVO-konform, mit klaren Freigaben und ohne IT-Stress.",
  steps = [
    {
      number: 1,
      title: "Klarheit schaffen",
      description:
        "Wir verstehen deinen Ablauf, wählen den besten Startpunkt für einen Agenten-Workflow und legen gemeinsam fest, woran der größte Erfolg gemessen wird.",
      details: [
        "Engpässe, Datenquellen und Zuständigkeiten erfassen",
        "Tool-, Daten- und Integrations-Check",
        "Sicherheitsrahmen: Zugriffe, Freigaben und Logs",
        "Messwerte für Wirkung und Risiko definieren",
      ],
      duration: "3 bis 5 Tage",
      result:
        "Du weißt genau, was gebaut wird, welche Daten betroffen sind und wie sicher gestartet wird.",
    },
    {
      number: 2,
      title: "Agenten-Workflow umsetzen und verbinden",
      description:
        "Wir bauen den KI-Agenten und verbinden deine Systeme, damit Aufgaben vorbereitet, weitergegeben und bei Bedarf freigegeben werden.",
      details: [
        "n8n-Agent oder agentisches Setup als kleinster sinnvoller Start",
        "Anbindung an E-Mail, CRM, Kalender, Dokumente oder Wissensquellen",
        "Policies für personenbezogene Daten und sensible Schritte",
        "Tests mit echten Beispielen aus deinem Alltag",
      ],
      duration: "2 bis 6 Wochen",
      result:
        "Der Agent läuft nachvollziehbar, bereitet Arbeit vor und bleibt unter menschlicher Kontrolle.",
    },
    {
      number: 3,
      title: "Einführen und stabilisieren",
      description:
        "Wir bringen die Lösung gemeinsam mit dir in den Alltag. Du bekommst eine klare Einweisung, damit du jederzeit weißt, was der Agent tut und wie du eingreifen kannst.",
      details: [
        "Pilotbetrieb mit Review-Schleifen",
        "Einweisung für Team, Freigaben und Sonderfälle",
        "Monitoring von Fehlern, Datenqualität und Wirkung",
        "Optionaler Ausbau Richtung OpenClaw-Agenten-Setup",
      ],
      duration: "2 bis 8 Wochen Begleitung",
      result:
        "Ein stabiler Agenten-Workflow, der genutzt wird und später kontrolliert skalieren kann.",
    },
  ],
} = Astro.props;
---

<section id="process" data-enterprise-section class="deployment-flow">
  <div class="saas-container">
    <div class="saas-heading saas-heading--center enterprise-reveal">
      <span>Delivery Framework</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="deployment-flow__shell enterprise-card">
      {
        steps.map((step) => (
          <article class="deploy-phase enterprise-reveal">
            <div class="deploy-phase__header">
              <span>{step.duration}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
            <ul>
              {step.details.map((detail) => (
                <li>{detail}</li>
              ))}
            </ul>
            <strong>{step.result}</strong>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .deployment-flow {
    background: #ffffff;
    padding: clamp(4.5rem, 8vw, 7rem) 0;
  }

  .deployment-flow__shell {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2.8rem;
    padding: 1rem;
    background: linear-gradient(
      135deg,
      rgba(248, 250, 252, 0.98),
      rgba(236, 246, 244, 0.78)
    );
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 18px;
    box-shadow: 0 28px 80px rgba(15, 23, 42, 0.08);
  }

  .deploy-phase {
    display: flex;
    flex-direction: column;
    min-height: 32rem;
    padding: 1.35rem;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-radius: 14px;
  }

  .deploy-phase__header span {
    display: inline-flex;
    color: #0f766e;
    background: rgba(20, 184, 166, 0.1);
    border-radius: 7px;
    padding: 0.38rem 0.52rem;
    font-size: 0.78rem;
    font-weight: 900;
  }

  .deploy-phase h3 {
    margin-top: 1.1rem;
    color: #0b1220;
    font-size: clamp(1.45rem, 2.1vw, 2.25rem);
    font-weight: 920;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .deploy-phase p,
  .deploy-phase li,
  .deploy-phase strong {
    color: #64748b;
    font-size: 0.96rem;
    font-weight: 580;
    line-height: 1.48;
  }

  .deploy-phase p {
    margin-top: 0.9rem;
  }

  .deploy-phase ul {
    display: grid;
    gap: 0.72rem;
    margin-top: 1.4rem;
  }

  .deploy-phase li {
    position: relative;
    padding-left: 1.35rem;
  }

  .deploy-phase li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 3px;
    background: #14b8a6;
  }

  .deploy-phase strong {
    display: block;
    margin-top: auto;
    color: #0b1220;
    font-weight: 850;
  }

  @media (max-width: 980px) {
    .deployment-flow__shell {
      grid-template-columns: 1fr;
    }

    .deploy-phase {
      min-height: auto;
    }
  }
</style>
