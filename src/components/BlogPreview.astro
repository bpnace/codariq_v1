---
export interface Props {
  title?: string;
  subtitle?: string;
  showAllLink?: boolean;
}

const {
  title = "KI-Integration, Projektrettung und Agenten-Workflows verständlich erklärt",
  subtitle = "Artikel für Selbstständige, kleine Teams und KMU in DACH. Du siehst, wie KI-Integration in bestehende Systeme gelingt, wann KI-Remediation sinnvoll ist und wie du Prozesse nach ROI priorisierst.",
  showAllLink = true,
} = Astro.props;

const posts = [
  {
    href: "/blog/ki-integration-bestehende-systeme",
    label: "KI-Integration",
    title: "KI-Integration in bestehende Systeme",
    description:
      "Wie du KI sauber mit CRM, E-Mail, Kalender und Buchhaltung verbindest, statt durch neue Software für KI-Cloud-Integration zusätzliches Tool-Chaos zu erzeugen.",
    time: "11 Min.",
  },
  {
    href: "/blog/ki-mitarbeiterumfragen-automatisieren",
    label: "Teamfeedback",
    title: "KI-Mitarbeiterumfragen automatisiert auswerten",
    description:
      "Wie kleine Teams Mitarbeiterumfragen automatisiert auswerten, Risiken erkennen und aus Feedback konkrete Maßnahmen machen.",
    time: "10 Min.",
  },
  {
    href: "/blog/ki-remediation-projekte-retten",
    label: "KI-Remediation",
    title: "Festgefahrene KI-Projekte wieder in Betrieb bringen",
    description:
      "Ein Reparaturplan für KI-Projektrettung, KI-Remediation und Projekte, die nicht genutzt werden oder im Betrieb hängen bleiben.",
    time: "12 Min.",
  },
];
---

<section id="insights" data-enterprise-section class="resource-suite">
  <div class="saas-container">
    <div class="resource-suite__heading enterprise-reveal">
      <span>Knowledge Base</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="resource-suite__grid">
      {
        posts.map((post) => (
          <article class="resource-card enterprise-card">
            <a href={post.href}>
              <span>{post.label}</span>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
              <strong>{post.time} Lesezeit</strong>
            </a>
          </article>
        ))
      }
    </div>

    {
      showAllLink && (
        <div class="resource-suite__all enterprise-reveal">
          <a href="/blog">Alle Artikel ansehen</a>
        </div>
      )
    }
  </div>
</section>

<style>
  .resource-suite {
    background: #f7fafc;
    padding: clamp(4.5rem, 2vw, 7rem) 0;
  }

  .resource-suite__heading {
    display: grid;
    grid-template-columns: minmax(20rem, 0.64fr) minmax(22rem, 0.58fr);
    grid-template-areas:
      "eyebrow ."
      "title copy";
    gap: 1rem clamp(2rem, 5vw, 5rem);
    align-items: center;
    justify-content: center;
    max-width: 72rem;
    margin-inline: auto;
  }

  .resource-suite__heading > span {
    display: inline-flex;
    grid-area: eyebrow;
    width: fit-content;
    color: #ecfeff;
    background: #0f766e;
    border-radius: 7px;
    padding: 0.42rem 0.56rem;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .resource-suite__heading h2 {
    grid-area: title;
    max-width: 23ch;
    color: #0b1220;
    font-size: clamp(2.25rem, 3.7vw, 4.15rem);
    font-weight: 940;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .resource-suite__heading p {
    grid-area: copy;
    max-width: 42rem;
    color: #64748b;
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    font-weight: 580;
    line-height: 1.55;
  }

  .resource-suite__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2.8rem;
  }

  .resource-card {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.06);
    transition:
      transform 170ms cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 170ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .resource-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 30px 70px rgba(15, 23, 42, 0.1);
  }

  .resource-card a {
    display: flex;
    min-height: 20rem;
    flex-direction: column;
    padding: 1.25rem;
  }

  .resource-card span {
    color: #0f766e;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .resource-card h3 {
    margin-top: 1rem;
    color: #0b1220;
    font-size: clamp(1.35rem, 1.9vw, 2rem);
    font-weight: 920;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .resource-card p {
    margin-top: 1rem;
    color: #64748b;
    font-size: 0.98rem;
    font-weight: 570;
    line-height: 1.5;
  }

  .resource-card strong {
    margin-top: auto;
    color: #0f766e;
    font-size: 0.9rem;
    font-weight: 900;
  }

  .resource-suite__all {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .resource-suite__all a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.82rem 1rem;
    background: #0b1220;
    color: #f8fafc;
    border-radius: 8px;
    font-weight: 900;
    transition:
      transform 170ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 170ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .resource-suite__all a:hover {
    background: #14332f;
  }

  .resource-suite__all a:active {
    transform: translateY(1px) scale(0.985);
  }

  @media (max-width: 960px) {
    .resource-suite__heading {
      grid-template-columns: 1fr;
      grid-template-areas:
        "eyebrow"
        "title"
        "copy";
      max-width: 42rem;
      text-align: left;
    }

    .resource-suite__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
