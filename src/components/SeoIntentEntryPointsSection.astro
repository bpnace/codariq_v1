---
const entryPoints = [
  {
    href: "/ki-integration-prozesse",
    eyebrow: "KI-Integration Prozesse",
    title: "KI in bestehende Abläufe integrieren",
    text: "Für Unternehmen, die wissen wollen, welcher Prozess zuerst KI bekommen sollte und wie Daten, Freigaben und Betrieb zusammenpassen.",
    cta: "Prozess prüfen",
  },
  {
    href: "/crm-und-ki-integration",
    eyebrow: "CRM Integration",
    title: "CRM, E-Mail und Cloud-Tools verbinden",
    text: "Für Teams, die Leads, Follow-ups, Support oder Datenpflege vorbereiten lassen wollen, ohne das CRM als führendes System zu verlieren.",
    cta: "CRM-Setup ansehen",
  },
  {
    href: "/ki-projekt-retten",
    eyebrow: "KI-Projektrettung",
    title: "Festgefahrenes KI-Projekt retten",
    text: "Für Projekte, die in der Demo gut aussahen, aber im Alltag an Daten, Prompts, Übergaben oder Betrieb hängen.",
    cta: "Projekt prüfen",
  },
];
---

<section id="seo-einstiege" data-enterprise-section class="intent-entry">
  <div class="saas-container">
    <div class="intent-entry__heading enterprise-reveal">
      <span>Suchst du etwas Bestimmtes?</span>
      <h2>Die nützlichsten Bereiche</h2>
      <p>
        Viele Anfragen kommen nicht mit „wir brauchen jetzt KI“, sondern mit
        einem konkreten Problem wie Integration, CRM oder einem Projekt, das
        nicht sauber läuft.
      </p>
    </div>

    <div class="intent-entry__grid">
      {
        entryPoints.map((item) => (
          <article class="intent-entry__card enterprise-card">
            <span>{item.eyebrow}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a href={item.href}>{item.cta}</a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .intent-entry {
    background: #ffffff;
    padding: clamp(4.5rem, 2vw, 7rem) 0;
  }

  .intent-entry__heading {
    display: grid;
    grid-template-columns: minmax(18rem, 0.58fr) minmax(24rem, 0.8fr);
    grid-template-areas:
      "eyebrow ."
      "title copy";
    gap: 1rem clamp(2rem, 5vw, 5rem);
    align-items: center;
    max-width: 76rem;
    margin-inline: auto;
  }

  .intent-entry__heading > span {
    display: inline-flex;
    grid-area: eyebrow;
    width: fit-content;
    color: #ecfeff;
    background: #0f766e;
    border-radius: 7px;
    padding: 0.42rem 0.56rem;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .intent-entry__heading h2 {
    grid-area: title;
    max-width: 24ch;
    color: #0b1220;
    font-size: clamp(2.25rem, 3.7vw, 4.15rem);
    font-weight: 940;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .intent-entry__heading p {
    grid-area: copy;
    max-width: 42rem;
    color: #64748b;
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    font-weight: 580;
    line-height: 1.55;
  }

  .intent-entry__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.8rem;
  }

  .intent-entry__card {
    display: flex;
    min-height: 19rem;
    flex-direction: column;
    padding: 1.25rem;
    background: #f8fafc;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.06);
    transition:
      border-color 170ms cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 170ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .intent-entry__card:hover {
    border-color: rgba(15, 118, 110, 0.26);
    box-shadow: 0 28px 64px rgba(15, 23, 42, 0.08);
  }

  .intent-entry__card span {
    color: #0f766e;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .intent-entry__card h3 {
    margin-top: 1rem;
    color: #0b1220;
    font-size: clamp(1.35rem, 1.9vw, 2rem);
    font-weight: 920;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .intent-entry__card p {
    margin-top: 1rem;
    color: #64748b;
    font-size: 0.98rem;
    font-weight: 570;
    line-height: 1.5;
  }

  .intent-entry__card a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 2.75rem;
    margin-top: auto;
    padding: 0.72rem 0.9rem;
    border: 1px solid rgba(15, 118, 110, 0.26);
    border-radius: 8px;
    color: #0f766e;
    font-size: 0.9rem;
    font-weight: 900;
    transition:
      background-color 170ms cubic-bezier(0.23, 1, 0.32, 1),
      border-color 170ms cubic-bezier(0.23, 1, 0.32, 1),
      color 170ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 170ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .intent-entry__card a:hover {
    background: #0f766e;
    border-color: #0f766e;
    color: #ecfeff;
    transform: translateY(-1px);
  }

  .intent-entry__card a:active {
    transform: translateY(0) scale(0.985);
  }

  .intent-entry__card a:focus-visible {
    outline: 3px solid rgba(20, 184, 166, 0.42);
    outline-offset: 3px;
  }

  @media (max-width: 960px) {
    .intent-entry__heading {
      grid-template-columns: 1fr;
      grid-template-areas:
        "eyebrow"
        "title"
        "copy";
      max-width: 42rem;
    }

    .intent-entry__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
