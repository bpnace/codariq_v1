---
import ArrowRight from "./icons/ArrowRight.astro";

export interface Props {
  title?: string;
  subtitle?: string;
  primaryCTA?: string;
  secondaryCTA?: string;
  primaryCTALink?: string;
  secondaryCTALink?: string;
  heroImage?: string;
  primaryTextClass?: string;
  secondaryTextClass?: string;
  subtextClass?: string;
  stats?: Array<{ value: string; label: string }>;
}

const {
  title = "KI-Agenten, die deinen Alltag tatsächlich entlasten.",
  subtitle = "Wir bauen kontrollierbare KI-Agenten und KI-Integrationen, die E-Mails, Leads, Dokumente und bestehende Systeme sauber verbinden. DSGVO-konform, verständlich erklärt, in wenigen Wochen spürbar.",
  primaryCTA = "Jetzt Termin buchen",
  secondaryCTA = "Agenten-Potenzial prüfen",
  primaryCTALink = "#final-cta",
  secondaryCTALink = "#benefits",
} = Astro.props;

const trustSignals = [
  "Automatisch vorsortiert",
  "Freigabe bei wichtigen Schritten",
  "Saubere Übergabe ans Team",
];

const briefingItems = [
  { label: "Erledigt", value: "23 E-Mails sortiert", state: "ohne Rückfrage" },
  {
    label: "Vorbereitet",
    value: "5 Antworten als Entwurf",
    state: "prüfbereit",
  },
  {
    label: "Priorisiert",
    value: "2 Entscheidungen offen",
    state: "Chef-Fokus",
  },
];
---

<section id="hero" data-enterprise-section class="secure-hero">
  <div
    class="secure-hero__ambient secure-hero__ambient--green"
    aria-hidden="true"
  >
  </div>
  <div
    class="secure-hero__ambient secure-hero__ambient--blue"
    aria-hidden="true"
  >
  </div>

  <div class="secure-hero__inner">
    <div class="secure-hero__copy enterprise-reveal">
      <div class="secure-hero__kicker">
        KI-Agenten bereiten vor, du entscheidest
      </div>
      <h1>{title}</h1>
      <p>{subtitle}</p>

      <div class="secure-hero__actions">
        <a
          href={primaryCTALink}
          class="secure-button secure-button--primary group"
          aria-label={primaryCTA}
        >
          <span>{primaryCTA}</span>
          <ArrowRight
            class="h-5 w-5 transition-transform duration-200 ease-out group-hover:translate-x-1"
          />
        </a>
        <a
          href={secondaryCTALink}
          class="secure-button secure-button--secondary group"
          aria-label={secondaryCTA}
        >
          <span>{secondaryCTA}</span>
          <ArrowRight
            class="h-5 w-5 transition-transform duration-200 ease-out group-hover:translate-x-1"
          />
        </a>
      </div>

      <ul class="secure-hero__trust" aria-label="Arbeitsweise des KI-Agenten">
        {
          trustSignals.map((signal) => (
            <li>
              <span aria-hidden="true" />
              {signal}
            </li>
          ))
        }
      </ul>
    </div>

    <aside
      class="secure-console enterprise-reveal"
      aria-label="Geschäftsführer-Briefing eines KI-Agenten"
    >
      <div class="secure-console__topbar">
        <div>
          <span>KI-Agent meldet</span>
          <strong>Morgen-Briefing</strong>
        </div>
        <p>08:15 Uhr</p>
      </div>

      <div class="secure-console__status">
        <div>
          <span>Heute vom Team genommen</span>
          <strong>4,6 Std.</strong>
        </div>
        <div class="secure-console__ring" aria-hidden="true">
          <span></span>
        </div>
      </div>

      <div class="secure-console__pipeline">
        {
          briefingItems.map((item) => (
            <article class="pipeline-card">
              <span>{item.label}</span>
              <strong>{item.value}</strong>
              <p>{item.state}</p>
            </article>
          ))
        }
      </div>

      <div class="decision-panel">
        <div>
          <span>Nächster sinnvoller Schritt</span>
          <strong>Kundenthemen mit Umsatzbezug prüfen</strong>
          <p>
            Der Agent hat Kontext, Vorschlag und nächste Aktion vorbereitet. Du
            entscheidest nur noch, was rausgeht.
          </p>
        </div>
        <button type="button">Entscheidung ansehen</button>
      </div>

      <div
        class="handover-stream"
        aria-label="Vom KI-Agenten übernommene Arbeit"
      >
        <span>Agent hat übernommen</span>
        <p><strong>Posteingang</strong> Anfragen erkannt und priorisiert</p>
        <p><strong>CRM</strong> Kontakte ergänzt und Follow-ups vorbereitet</p>
        <p><strong>Team</strong> Aufgaben gebündelt statt weitergereicht</p>
      </div>
    </aside>
  </div>
</section>

<style>
  .secure-hero {
    position: relative;
    min-height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    background:
      radial-gradient(
        circle at 12% 18%,
        rgba(20, 184, 166, 0.15),
        transparent 28rem
      ),
      radial-gradient(
        circle at 84% 16%,
        rgba(59, 130, 246, 0.12),
        transparent 30rem
      ),
      linear-gradient(135deg, #f7fafc 0%, #edf4f8 52%, #f6fbf8 100%);
    color: #0b1220;
    padding: 2rem 0 4.5rem;
  }

  .secure-hero__ambient {
    position: absolute;
    pointer-events: none;
    filter: blur(12px);
    opacity: 0.9;
    will-change: transform;
  }

  .secure-hero__ambient--green {
    right: 8vw;
    top: 18vh;
    width: 18rem;
    height: 18rem;
    background: rgba(20, 184, 166, 0.14);
  }

  .secure-hero__ambient--blue {
    left: 4vw;
    bottom: 8vh;
    width: 16rem;
    height: 16rem;
    background: rgba(37, 99, 235, 0.1);
  }

  .secure-hero__inner {
    position: relative;
    width: min(100% - 2rem, 1440px);
    margin: clamp(1.5rem, 4vw, 3.5rem) auto 0;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(30rem, 1fr);
    gap: clamp(2.4rem, 5vw, 6rem);
    align-items: center;
    perspective: 1400px;
    perspective-origin: 74% 42%;
  }

  .secure-hero__copy {
    max-width: 47rem;
  }

  .secure-hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.25rem;
    padding: 0 0.85rem;
    background: rgba(255, 255, 255, 0.72);
    color: #14332f;
    border: 1px solid rgba(20, 51, 47, 0.12);
    border-radius: 10px;
    font-size: 0.86rem;
    font-weight: 850;
    box-shadow: 0 14px 40px rgba(15, 23, 42, 0.06);
  }

  .secure-dot {
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 2px;
    background: #14b8a6;
    box-shadow: 0 0 0 4px rgba(20, 184, 166, 0.14);
  }

  .secure-hero h1 {
    margin-top: 1.45rem;
    color: #0b1220;
    font-size: clamp(2.7rem, 4.8vw, 5.25rem);
    font-weight: 950;
    letter-spacing: -0.058em;
    line-height: 0.98;
  }

  .secure-hero__copy > p {
    margin-top: 1.5rem;
    max-width: 42rem;
    color: #475569;
    font-size: clamp(1.08rem, 1.45vw, 1.34rem);
    font-weight: 580;
    line-height: 1.55;
  }

  .secure-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.2rem;
  }

  .secure-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 3.35rem;
    padding: 0.95rem 1.18rem;
    border-radius: 8px;
    font-weight: 900;
    line-height: 1;
    transition:
      transform 170ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 170ms cubic-bezier(0.23, 1, 0.32, 1),
      color 170ms cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 170ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .secure-button:active {
    transform: translateY(1px) scale(0.985);
  }

  .secure-button--primary {
    background: #0b1220;
    color: #f8fafc;
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.24);
  }

  .secure-button--primary:hover {
    background: #14332f;
  }

  .secure-button--secondary {
    background: rgba(255, 255, 255, 0.78);
    color: #0b1220;
    border: 1px solid rgba(15, 23, 42, 0.13);
  }

  .secure-button--secondary:hover {
    background: #ffffff;
    border-color: rgba(20, 184, 166, 0.42);
  }

  .secure-hero__trust {
    display: grid;
    gap: 0.7rem;
    margin-top: 2rem;
    color: #334155;
    font-size: 0.96rem;
    font-weight: 720;
  }

  .secure-hero__trust li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .secure-hero__trust li span {
    width: 1rem;
    height: 1rem;
    border-radius: 4px;
    background: linear-gradient(
      135deg,
      rgba(20, 184, 166, 0.95),
      rgba(20, 51, 47, 0.9)
    );
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.28);
  }

  .secure-console {
    --console-light-x: 58;
    --console-light-y: 28;
    position: relative;
    padding: clamp(1rem, 1.6vw, 1.35rem);
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 18px;
    box-shadow:
      0 28px 90px rgba(15, 23, 42, 0.16),
      -26px 32px 80px rgba(20, 184, 166, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.74);
    backdrop-filter: blur(18px);
    transform: rotateX(-2deg) rotateY(-5deg);
    transform-origin: 50% 50%;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    isolation: isolate;
    will-change: transform;
  }

  .secure-console::before {
    content: "";
    position: absolute;
    inset: 0.55rem;
    border-radius: 12px;
    background: linear-gradient(
      135deg,
      rgba(20, 184, 166, 0.08),
      transparent 45%,
      rgba(37, 99, 235, 0.06)
    );
    pointer-events: none;
  }

  .secure-console::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      radial-gradient(
        circle at calc(var(--console-light-x) * 1%)
          calc(var(--console-light-y) * 1%),
        rgba(255, 255, 255, 0.62),
        transparent 28%
      ),
      linear-gradient(
        118deg,
        rgba(255, 255, 255, 0.16),
        transparent 38%,
        rgba(20, 184, 166, 0.14) 82%,
        rgba(37, 99, 235, 0.11)
      );
    opacity: 0.78;
    pointer-events: none;
    z-index: 1;
    transform: translateZ(34px);
  }

  .secure-console > * {
    position: relative;
    z-index: 2;
    transform: translateZ(24px);
  }

  .secure-console__topbar,
  .secure-console__status,
  .decision-panel,
  .handover-stream {
    background: rgba(248, 250, 252, 0.86);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 12px;
  }

  .secure-console__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
  }

  .secure-console__topbar span,
  .secure-console__status span,
  .pipeline-card span,
  .decision-panel span,
  .handover-stream > span {
    display: block;
    color: #64748b;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .secure-console__topbar strong {
    display: block;
    margin-top: 0.24rem;
    color: #0b1220;
    font-size: 1.12rem;
    font-weight: 900;
  }

  .secure-console__topbar p {
    color: #14332f;
    background: rgba(20, 184, 166, 0.12);
    border-radius: 7px;
    padding: 0.42rem 0.55rem;
    font-size: 0.82rem;
    font-weight: 850;
  }

  .secure-console__status {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: center;
    margin-top: 0.85rem;
    padding: 1.1rem;
    background: #0b1220;
  }

  .secure-console__status strong {
    display: block;
    margin-top: 0.3rem;
    color: #f8fafc;
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 950;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .secure-console__ring {
    display: grid;
    place-items: center;
    width: 5.4rem;
    height: 5.4rem;
    border-radius: 50%;
    background: conic-gradient(
      #14b8a6 0 82%,
      rgba(255, 255, 255, 0.14) 82% 100%
    );
  }

  .secure-console__ring span {
    width: 3.7rem;
    height: 3.7rem;
    border-radius: 50%;
    background: #0b1220;
  }

  .secure-console__pipeline {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 0.85rem;
  }

  .pipeline-card {
    min-height: 8rem;
    padding: 0.9rem;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 12px;
    transform: translateZ(34px);
  }

  .pipeline-card strong {
    display: block;
    margin-top: 1.1rem;
    color: #0b1220;
    font-size: 1.16rem;
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .pipeline-card p {
    margin-top: 0.65rem;
    color: #0f766e;
    font-size: 0.86rem;
    font-weight: 850;
  }

  .decision-panel {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: end;
    margin-top: 0.85rem;
    padding: 1.1rem;
  }

  .decision-panel strong {
    display: block;
    margin-top: 0.45rem;
    color: #0b1220;
    font-size: 1.2rem;
    font-weight: 900;
  }

  .decision-panel p {
    margin-top: 0.45rem;
    max-width: 30rem;
    color: #475569;
    font-size: 0.94rem;
    font-weight: 620;
    line-height: 1.45;
  }

  .decision-panel button {
    min-height: 2.7rem;
    padding: 0.75rem 0.95rem;
    color: #f8fafc;
    background: #14332f;
    border: 0;
    border-radius: 8px;
    font-weight: 900;
    white-space: nowrap;
  }

  .handover-stream {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.85rem;
    padding: 1rem;
  }

  .handover-stream p {
    color: #475569;
    font-size: 0.86rem;
    font-weight: 650;
  }

  .handover-stream strong {
    color: #0b1220;
    font-weight: 900;
  }

  @media (max-width: 1040px) {
    .secure-hero__inner {
      grid-template-columns: 1fr;
      perspective-origin: 50% 48%;
    }
  }

  @media (max-width: 640px) {
    .secure-hero {
      padding-top: 6.8rem;
    }

    .secure-hero__actions,
    .secure-button,
    .decision-panel {
      width: 100%;
    }

    .secure-console__pipeline,
    .decision-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
