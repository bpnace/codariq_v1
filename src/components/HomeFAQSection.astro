---
export interface Props {
  title?: string;
  subtitle?: string;
  faqs?: Array<{
    question: string;
    answer: string;
  }>;
}

const {
  title = "Was vorher geklärt sein muss",
  subtitle = "Ein Agent kann nur sauber arbeiten, wenn Datenwege, Rollen und Freigaben stimmen. Hier beantworten wir, was vor dem ersten Einsatz wirklich wichtig ist.",
  faqs = [
    {
      question: "Womit starten wir am besten?",
      answer:
        "Mit einem Ablauf, der regelmäßig vorkommt und heute manuell Zeit kostet. Gute Startpunkte sind Postfach sortieren, Dokumentenablage, Antwortentwürfe, CRM-Pflege oder interne Rückfragen.",
    },
    {
      question: "Wie schnell kann ein erster Agent live sein?",
      answer:
        "Ein eindeutig begrenzter Agenten-Workflow ist oft in wenigen Wochen nutzbar. Entscheidend sind Datenzugang, Tool-Anbindung und wie eindeutig Freigaben und Sonderfälle definiert sind.",
    },
    {
      question: "Bleiben sensible Daten kontrollierbar?",
      answer:
        "Ja. Wir planen Rollen, Zugriffe, Datenflüsse und Freigaben vor der Umsetzung. Kritische Aktionen werden vorbereitet statt blind ausgeführt, damit du nachvollziehen kannst, was der Agent tut.",
    },
    {
      question: "Was bedeutet der EU AI Act für den Start?",
      answer:
        "Wir ordnen vorab ein, welche Rolle dein Agent im Ablauf hat, welche Risiken entstehen und welche Kontrolle sichtbar bleiben muss. Es geht nicht um Panik, sondern um saubere Grenzen, Freigaben und Dokumentation.",
    },
    {
      question: "Welche Aktionen brauchen immer Freigabe?",
      answer:
        "Alles, was nach außen wirkt oder sensible Daten verändert: Nachrichten, Ablehnungen, Kundendaten, HR-Themen, Zahlungen und kritische Entscheidungen. Der Agent bereitet vor, ein Mensch gibt frei.",
    },
    {
      question: "Muss ich technisch vorbereitet sein?",
      answer:
        "Nein. Du bringst Beispiele aus deinem Alltag mit, wir übersetzen daraus den technischen Ablauf. Am Ende bekommst du eine verständliche Übergabe statt zusätzlicher Tool-Komplexität.",
    },
    {
      question: "Können bestehende Tools angebunden werden?",
      answer:
        "Ja. Typisch sind E-Mail, Kalender, CRM, Formulare, Dokumentenablagen und Buchhaltung. Wir prüfen zuerst, welche Verbindung stabil und sinnvoll ist.",
    },
    {
      question: "Was passiert nach dem Livegang?",
      answer:
        "Wir beobachten die ersten Ergebnisse, fangen Sonderfälle ab und justieren nach. Optional bleibt Betreuung möglich, wenn sich Tools, Daten oder Prozesse ändern.",
    },
  ],
} = Astro.props;
---

<section id="home-faq" data-enterprise-section class="home-faq">
  <div class="saas-container">
    <div class="home-faq__heading enterprise-reveal">
      <span>FAQ</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="home-faq__grid">
      {
        faqs.map((faq) => (
          <details class="home-faq__item enterprise-card">
            <summary>
              <h3>{faq.question}</h3>
              <span aria-hidden="true">+</span>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>

    <div class="home-faq__footer enterprise-reveal">
      <p>Noch Fragen? Die vollständige FAQ sammlung findest du hier.</p>
      <a href="/faq">Alle FAQ's lesen</a>
    </div>
  </div>
</section>

<style>
  .home-faq {
    background: #f7fafc;
    padding: clamp(4.5rem, 2vw, 7rem) 0;
  }

  .home-faq__heading {
    display: grid;
    grid-template-columns: minmax(20rem, 0.64fr) minmax(22rem, 0.58fr);
    grid-template-areas:
      "eyebrow ."
      "title copy";
    gap: 1rem clamp(2rem, 5vw, 5rem);
    align-items: center;
    justify-content: center;
    max-width: 72rem;
    margin-inline: auto;
  }

  .home-faq__heading > span {
    display: inline-flex;
    grid-area: eyebrow;
    width: fit-content;
    color: #ecfeff;
    background: #0f766e;
    border-radius: 7px;
    padding: 0.42rem 0.56rem;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-faq__heading h2 {
    grid-area: title;
    max-width: 23ch;
    color: #0b1220;
    font-size: clamp(2.25rem, 3.7vw, 4.15rem);
    font-weight: 940;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .home-faq__heading p {
    grid-area: copy;
    max-width: 42rem;
    color: #64748b;
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    font-weight: 580;
    line-height: 1.55;
  }

  .home-faq__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.8rem;
  }

  .home-faq__item {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.06);
    overflow: hidden;
  }

  .home-faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .home-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .home-faq__item h3 {
    color: #0b1220;
    font-size: clamp(1.08rem, 1.35vw, 1.32rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .home-faq__item summary span {
    display: grid;
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 8px;
    background: rgba(20, 184, 166, 0.12);
    color: #0f766e;
    font-size: 1.2rem;
    font-weight: 900;
    transition:
      transform 170ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 170ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .home-faq__item[open] summary span {
    transform: rotate(45deg);
    background: #14b8a6;
    color: #052e2b;
  }

  .home-faq__item p {
    padding: 0 1.25rem 1.25rem;
    color: #64748b;
    font-size: 0.98rem;
    font-weight: 570;
    line-height: 1.55;
  }

  .home-faq__footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
    color: #64748b;
    font-size: 0.96rem;
    font-weight: 580;
  }

  .home-faq__footer a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.82rem 1rem;
    background: #0b1220;
    color: #f8fafc;
    border-radius: 8px;
    font-weight: 900;
    transition:
      transform 170ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 170ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .home-faq__footer a:hover {
    background: #14332f;
  }

  .home-faq__footer a:active {
    transform: translateY(1px) scale(0.985);
  }

  @media (max-width: 960px) {
    .home-faq__heading,
    .home-faq__grid,
    .home-faq__footer {
      grid-template-columns: 1fr;
    }

    .home-faq__heading {
      grid-template-areas:
        "eyebrow"
        "title"
        "copy";
      max-width: 42rem;
      text-align: left;
    }

    .home-faq__footer {
      align-items: stretch;
      flex-direction: column;
    }

    .home-faq__footer a {
      width: 100%;
    }
  }
</style>
