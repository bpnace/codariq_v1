---
export interface Props {
  title?: string;
  subtitle?: string;
  benefits?: Array<{
    title: string;
    description: string;
    icon: string;
    features: string[];
    highlight?: boolean;
    price?: string;
    duration?: string;
    isProduct?: boolean;
    additionalInfo?: string;
    colorTheme?: string;
  }>;
  additionalServices?: Array<{
    title: string;
    subtitle: string;
    description: string;
    features: string[];
    note?: string;
    price: string;
    duration: string;
    icon: string;
    comingSoon?: boolean;
  }>;
}

const {
  title = "Pakete für KI-Agenten und Integration",
  subtitle = "Du bekommst einen klaren Rahmen für Umfang und Kosten. Die Umsetzung wird an deinen Ablauf, deinen Tool-Stack und die nötigen Freigaben angepasst. Wir kümmern uns um Datenschutz und saubere Abläufe.",
  benefits = [
    {
      title: "Starter Paket",
      description:
        "Für Selbstständige und kleine Teams, die einen Ablauf spürbar entlasten wollen. Auch wenn du allein bist: Automationen übernehmen Aufgaben wie ein zusätzliches Teammitglied.",
      icon: "starter",
      features: [
        "1 klarer Ablauf oder Agenten-Workflow",
        "Anbindung an vorhandene Tools",
        "Regeln für Sonderfälle und Freigaben",
        "Kurze Doku und Übergabe",
        "Optional: Betreuung ab 25 € pro Monat",
      ],
      price: "ab 399 €",
      duration: "einmalig",
      isProduct: true,
      additionalInfo: "Ein Bereich oder Prozess",
      colorTheme: "green",
    },
    {
      title: "Team Paket",
      description:
        "Für Selbstständige und kleine Teams, die mehrere Abläufe verbinden wollen, ohne dass es kompliziert wird. Deine Automationen und Agenten arbeiten wie ein eingespieltes Team im Hintergrund.",
      icon: "growth",
      features: [
        "Bis zu 3 verbundene Agenten-Workflows",
        "Automatische Übergaben zwischen Tools",
        "Tests mit echten Beispielen",
        "Einweisung für dich und dein Team",
        "Optional: Betreuung ab 59 € pro Monat",
      ],
      price: "ab 1.499 €",
      duration: "einmalig",
      highlight: true,
      isProduct: true,
      additionalInfo: "Mehrere Abläufe als System",
      colorTheme: "blue",
    },
    {
      title: "Wachstums Paket",
      description:
        "Für Selbstständige und Teams bis 50 Personen, die einen Bereich stabil und dauerhaft automatisieren wollen. So schaffst du mehr Volumen, ohne ständig neue Leute zu brauchen.",
      icon: "scale",
      features: [
        "Ein kompletter Bereich wie Support oder Backoffice",
        "Zugriffsschutz, Rollen und Protokolle",
        "Wirkungs- und Risikoauswertung",
        "Begleitung in den ersten Wochen",
        "Optional: Betreuung ab 99 € pro Monat",
      ],
      price: "ab 3.499 €",
      duration: "einmalig",
      isProduct: true,
      additionalInfo: "Bereich mit Skalierungspotenzial",
      colorTheme: "green",
    },
  ],
  additionalServices = [
    {
      title: "Jedes Mal mit dabei",
      subtitle: "",
      description:
        "Damit du dich nicht durch Technik kämpfen musst, sind diese Punkte immer inklusive, egal welches Paket du nimmst.",
      features: [
        "Klarer Startpunkt mit Agenten-Potenzial",
        "Fester Plan mit Dauer, Ergebnis und nötigen Tools",
        "Datenschutz sauber gelöst: Zugriffe, Datenfluss und Freigaben",
        "Tests mit echten Beispielen aus deinem Alltag",
        "Verständliche Übergabe statt technischer Abhängigkeit",
        "Betrieb so gebaut, dass Sonderfälle nicht untergehen",
      ],
      note: "Du musst kein IT-Wissen mitbringen. Wir erarbeiten zusammen das Ziel und kümmern uns um den Rest.",
      price: "",
      duration: "",
      icon: "included",
    },
  ],
} = Astro.props;
---

<section id="benefits" data-enterprise-section class="pricing-suite">
  <div class="saas-container">
    <div class="pricing-suite__heading enterprise-reveal">
      <span>Packages</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="pricing-suite__grid">
      {
        benefits.map((benefit) => (
          <article
            class={`pricing-card enterprise-card ${benefit.highlight ? "pricing-card--featured" : ""}`}
            data-benefit-system-card={benefit.highlight ? "true" : undefined}
          >
            {benefit.highlight && (
              <span class="pricing-card__badge">Empfohlen</span>
            )}
            <div class="pricing-card__head">
              <p
                class={benefit.highlight ? "pricing-card__system-label" : ""}
                data-benefit-system-label={
                  benefit.highlight ? "true" : undefined
                }
              >
                {benefit.additionalInfo}
              </p>
              <h3>{benefit.title}</h3>
              <strong>{benefit.price}</strong>
              <span>{benefit.duration}</span>
            </div>
            <p class="pricing-card__description">{benefit.description}</p>
            <ul>
              {benefit.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
            <a
              class={`pricing-card__cta ${benefit.highlight ? "pricing-card__cta--system" : ""}`}
              href="/#final-cta"
              data-benefit-system-cta={benefit.highlight ? "true" : undefined}
            >
              Setup prüfen
            </a>
          </article>
        ))
      }
    </div>

    {
      additionalServices.map((service) => (
        <aside class="included-panel enterprise-card enterprise-reveal">
          <div>
            <span>Included baseline</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
          <ul>
            {service.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
          {service.note && <strong>{service.note}</strong>}
        </aside>
      ))
    }
  </div>
</section>

<style>
  .pricing-suite {
    background: #f7fafc;
    padding: clamp(4.5rem, 2vw, 7rem) 0;
  }

  .pricing-suite__heading {
    display: grid;
    grid-template-columns: minmax(20rem, 0.64fr) minmax(22rem, 0.58fr);
    grid-template-areas:
      "eyebrow ."
      "title copy";
    gap: 1rem clamp(2rem, 5vw, 5rem);
    align-items: center;
    justify-content: center;
    max-width: 72rem;
    margin-inline: auto;
  }

  .pricing-suite__heading > span {
    display: inline-flex;
    grid-area: eyebrow;
    width: fit-content;
    color: #ecfeff;
    background: #0f766e;
    border-radius: 7px;
    padding: 0.42rem 0.56rem;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pricing-suite__heading h2 {
    grid-area: title;
    max-width: 23ch;
    color: #0b1220;
    font-size: clamp(2.25rem, 3.7vw, 4.15rem);
    font-weight: 940;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .pricing-suite__heading p {
    grid-area: copy;
    max-width: 42rem;
    color: #64748b;
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    font-weight: 580;
    line-height: 1.55;
  }

  .pricing-suite__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2.8rem;
  }

  .pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 37rem;
    padding: 1.35rem;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.07);
  }

  .pricing-card--featured {
    background: linear-gradient(180deg, #0b1220 0%, #14332f 100%);
    color: #f8fafc;
    transform: translateY(-0.8rem);
    box-shadow: 0 32px 90px rgba(15, 23, 42, 0.22);
  }

  .pricing-card__badge {
    position: absolute;
    z-index: 2;
    top: 1.1rem;
    right: 1.1rem;
    width: fit-content;
    padding: 0.42rem 0.58rem;
    background: #14b8a6;
    color: #052e2b;
    border-radius: 7px;
    font-size: 0.78rem;
    font-weight: 900;
  }

  .pricing-card__head p,
  .included-panel span {
    color: #0f766e;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pricing-card--featured .pricing-card__head p {
    color: #5eead4;
  }

  .pricing-card__system-label {
    position: relative;
    display: inline-flex;
    width: fit-content;
    margin-left: -0.42rem;
    padding: 0.22rem 0.42rem;
    overflow: hidden;
    border-radius: 7px;
    isolation: isolate;
  }

  .pricing-card__system-label::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    background: linear-gradient(
      90deg,
      rgba(20, 184, 166, 0.03) 0%,
      rgba(94, 234, 212, 0.2) 52%,
      rgba(20, 184, 166, 0.04) 100%
    );
    background-size: 220% 100%;
    opacity: 0.72;
    animation: pricing-system-label-glow 4.8s ease-in-out infinite;
  }

  .pricing-card h3 {
    margin-top: 0.8rem;
    color: inherit;
    font-size: clamp(1.55rem, 2.35vw, 2.35rem);
    font-weight: 930;
    letter-spacing: -0.055em;
    line-height: 0.96;
  }

  .pricing-card__head strong {
    display: block;
    margin-top: 1.6rem;
    color: inherit;
    font-size: clamp(1.9rem, 2.7vw, 2.8rem);
    font-weight: 950;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .pricing-card__head span,
  .pricing-card__description,
  .pricing-card li {
    color: #64748b;
    font-size: 0.96rem;
    font-weight: 580;
    line-height: 1.48;
  }

  .pricing-card--featured .pricing-card__head span,
  .pricing-card--featured .pricing-card__description,
  .pricing-card--featured li {
    color: #cbd5e1;
  }

  .pricing-card__description {
    margin-top: 1.4rem;
  }

  .pricing-card ul {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .pricing-card li {
    position: relative;
    padding-left: 1.35rem;
  }

  .pricing-card li::before,
  .included-panel li::before {
    content: "";
    position: absolute;
    top: 0.58rem;
    left: 0;
    width: 0.56rem;
    height: 0.56rem;
    border-radius: 3px;
    background: #14b8a6;
  }

  .pricing-card a {
    position: relative;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 3rem;
    margin-top: auto;
    padding: 0.82rem 1rem;
    border-radius: 8px;
    background: #0b1220;
    color: #f8fafc;
    font-weight: 900;
    transition:
      transform 170ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 170ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .pricing-card--featured a {
    background: #14b8a6;
    color: #052e2b;
  }

  .pricing-card__cta--system {
    overflow: visible;
    isolation: isolate;
  }

  .pricing-card__cta--system::before {
    position: absolute;
    inset: -0.28rem;
    z-index: -1;
    content: "";
    border: 0;
    border-radius: 13px;
    background: rgba(94, 234, 212, 0.24);
    filter: blur(8px);
    opacity: 0.2;
    transform: scale(0.96);
    transform-origin: center;
    animation: pricing-system-cta-halo 3.4s ease-out infinite;
  }

  .pricing-card a:hover {
    background: #14332f;
  }

  .pricing-card--featured a:hover {
    background: #5eead4;
  }

  .pricing-card a:active {
    transform: translateY(1px) scale(0.985);
  }

  @keyframes pricing-system-label-glow {
    0%,
    100% {
      background-position: 100% 50%;
      opacity: 0.52;
    }

    50% {
      background-position: 0% 50%;
      opacity: 0.86;
    }
  }

  @keyframes pricing-system-cta-halo {
    0% {
      opacity: 0.26;
      transform: scale(0.96);
    }

    58% {
      opacity: 0.08;
      transform: scale(1.12);
    }

    100% {
      opacity: 0;
      transform: scale(1.16);
    }
  }

  .included-panel {
    display: grid;
    grid-template-columns: 0.58fr 1fr 0.55fr;
    gap: 1.4rem;
    margin-top: 1rem;
    padding: 1.35rem;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.06);
  }

  .included-panel h3 {
    margin-top: 0.6rem;
    color: #0b1220;
    font-size: clamp(1.42rem, 2.1vw, 2.25rem);
    font-weight: 930;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .included-panel p,
  .included-panel li,
  .included-panel strong {
    color: #64748b;
    font-size: 0.95rem;
    font-weight: 580;
    line-height: 1.48;
  }

  .included-panel p {
    margin-top: 0.8rem;
  }

  .included-panel ul {
    columns: 2;
    column-gap: 1.2rem;
  }

  .included-panel li {
    position: relative;
    break-inside: avoid;
    margin-bottom: 0.65rem;
    padding-left: 1.25rem;
  }

  .included-panel strong {
    color: #0b1220;
    font-weight: 850;
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-card__system-label::before,
    .pricing-card__cta--system::before {
      animation: none;
    }
  }

  @media (max-width: 1040px) {
    .pricing-suite__heading {
      grid-template-columns: 1fr;
      grid-template-areas:
        "eyebrow"
        "title"
        "copy";
      max-width: 42rem;
      text-align: left;
    }

    .pricing-suite__grid,
    .included-panel {
      grid-template-columns: 1fr;
    }

    .pricing-card--featured {
      transform: none;
    }

    .included-panel ul {
      columns: 1;
    }
  }
</style>
